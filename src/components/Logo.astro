---
import { SITE } from 'astrowind:config';
import mark from '~/assets/favicons/favicon.svg';
---

<span class="inline-flex items-center gap-2.5">
  <img src={mark.src} width="32" height="32" alt="" class="h-8 w-8 shrink-0" aria-hidden="true" />
  <span class="text-[0.95rem] font-semibold tracking-tight whitespace-nowrap text-heading">{SITE?.name}</span>
</span>
