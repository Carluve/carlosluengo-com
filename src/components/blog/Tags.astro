---
import { getPermalink } from '~/utils/permalinks';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;
  title?: string | undefined;
  isCategory?: boolean;
}

const { tags, class: className = 'text-sm', title = undefined, isCategory = false } = Astro.props;

// Same pill as the category chips in BlogOverview, one size down.
const chipClass =
  'inline-flex items-center rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-muted';
---

{
  tags && Array.isArray(tags) && (
    <>
      {title !== undefined && (
        <span class="align-super font-normal underline underline-offset-4 decoration-2 dark:text-slate-400">
          {title}
        </span>
      )}
      <ul class:list={['flex list-none flex-wrap gap-2', className]}>
        {tags.map((tag) => (
          <li>
            {!APP_BLOG?.tag?.isEnabled ? (
              <span class={chipClass}>{tag.title}</span>
            ) : (
              <a
                href={getPermalink(tag.slug, isCategory ? 'category' : 'tag')}
                class:list={[
                  chipClass,
                  'transition-colors duration-200 hover:border-primary/40 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none',
                ]}
              >
                {tag.title}
              </a>
            )}
          </li>
        ))}
      </ul>
    </>
  )
}
