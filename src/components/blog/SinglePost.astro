---
import { getLang, localizePath, useTranslations, categoryLabel } from '~/i18n/utils';
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import TableOfContents from '~/components/blog/TableOfContents.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<div class="aw-read-progress" aria-hidden="true"></div>
<section class="mx-auto py-10 sm:py-14 lg:py-16">
  <article>
    <header>
      <div class="mx-auto mb-4 mt-0 max-w-3xl px-4 text-sm text-muted sm:px-6">
        <p class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
          <span class="inline-flex items-center gap-1">
            <Icon name="tabler:clock" class="h-4 w-4 shrink-0" aria-hidden="true" />
            <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate, lang)}</time>
          </span>
          {
            post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {t('blog.updated')}{' '}
                  <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate, lang)}</time>
                </span>
              </>
            )
          }
          {
            post.author && (
              <>
                <span aria-hidden="true">·</span>
                <span class="inline-flex items-center gap-1">
                  <Icon name="tabler:user" class="h-4 w-4 shrink-0" aria-hidden="true" />
                  {post.author}
                </span>
              </>
            )
          }
          {
            post.category && (
              <>
                <span aria-hidden="true">·</span>
                <a
                  class="hover:text-link hover:underline"
                  href={localizePath(getPermalink(post.category.slug, 'category'), lang)}
                >
                  {categoryLabel(post.category.slug, post.category.title, lang)}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {post.readingTime} {t('blog.readingTime')}
                </span>
              </>
            )
          }
        </p>
      </div>

      <h1
        class="mx-auto max-w-3xl px-4 font-heading text-4xl font-medium leading-tight tracking-tight text-balance text-heading sm:px-6 md:text-5xl"
      >
        {
          post.title.split(' ').map((word, i) => (
            <>
              <span style={`--i:${i}`}>{word}</span>{' '}
            </>
          ))
        }
      </h1>
      <p class="mx-auto mb-8 mt-4 max-w-3xl px-4 text-lg leading-relaxed text-pretty text-muted sm:px-6 md:text-xl">
        {post.excerpt}
      </p>

      <!-- Without a real image the post gets a thin rule, not the generated
           cover: that one is meant for the cards in the lists. -->
      {
        post.image ? (
          <div
            class="mx-auto mb-6 max-w-full overflow-hidden border border-line sm:rounded-xl lg:max-w-[900px]"
            transition:name={`cover-${post.slug}`}
          >
            <Image
              src={post.image}
              class="aspect-[900/506] w-full object-cover"
              widths={[400, 900]}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.imageAlt || ''}
              width={900}
              height={506}
              format="webp"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        ) : (
          <div class="mx-auto max-w-3xl px-4 sm:px-6">
            <hr class="border-line" />
          </div>
        )
      }
    </header>
    <!-- The width lives on a wrapper: .aw-prose is unlayered CSS with max-width:none,
         which would beat a max-w-* utility on the same element. -->
    <div class="relative mx-auto mt-8 max-w-3xl px-4 sm:px-6">
      <div class="aw-prose">
        <slot />
      </div>
      {
        post.headings && post.headings.length >= 3 && (
          <aside class="absolute left-full top-0 hidden h-full w-52 pl-6 xl:block 2xl:w-60 2xl:pl-8">
            <div class="sticky top-24">
              <TableOfContents headings={post.headings} />
            </div>
          </aside>
        )
      }
    </div>
    <div class="mx-auto mt-8 flex max-w-3xl flex-col justify-between px-4 sm:flex-row sm:px-6">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-3 shrink-0 sm:mt-0 sm:self-start" />
    </div>
  </article>
</section>

<script>
  // "Copiar" button on code blocks; the label swaps to "Copiado" with the
  // Text Swap transition from transitions.dev (MIT), see tailwind.css.
  const addCopyButtons = () => {
    for (const pre of document.querySelectorAll<HTMLPreElement>('.aw-prose pre:not([data-copy])')) {
      pre.dataset.copy = '';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'aw-copy';
      const en = document.documentElement.lang === 'en';
      const labels = en
        ? { copy: 'Copy', copied: 'Copied', copyLabel: 'Copy code', copiedLabel: 'Code copied' }
        : { copy: 'Copiar', copied: 'Copiado', copyLabel: 'Copiar el código', copiedLabel: 'Código copiado' };
      button.innerHTML = `<span class="aw-swap" data-state="idle"><span>${labels.copy}</span><span aria-hidden="true">${labels.copied}</span></span>`;
      button.setAttribute('aria-label', labels.copyLabel);
      button.addEventListener('click', async () => {
        const swap = button.querySelector<HTMLElement>('.aw-swap')!;
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
          swap.dataset.state = 'done';
          button.setAttribute('aria-label', labels.copiedLabel);
          setTimeout(() => {
            swap.dataset.state = 'idle';
            button.setAttribute('aria-label', labels.copyLabel);
          }, 1600);
        } catch {
          // Clipboard unavailable (insecure context or denied): keep the label.
        }
      });
      pre.append(button);
    }
  };
  document.addEventListener('astro:page-load', addCopyButtons);

  // "#" link next to each section heading: it copies the URL of the section
  // and puts the hash in the address bar without jumping.
  const addHeadingAnchors = () => {
    const en = document.documentElement.lang === 'en';
    const label = en ? 'Copy the link to this section' : 'Copiar el enlace a esta sección';
    const done = en ? 'Link copied' : 'Enlace copiado';
    for (const heading of document.querySelectorAll<HTMLElement>('.aw-prose :is(h2, h3)[id]:not([data-anchor])')) {
      heading.dataset.anchor = '';
      const link = document.createElement('a');
      link.className = 'aw-anchor';
      link.href = `#${heading.id}`;
      link.setAttribute('aria-label', label);
      link.dataset.done = done;
      link.textContent = '#';
      link.addEventListener('click', async (event) => {
        event.preventDefault();
        const url = `${location.origin}${location.pathname}#${heading.id}`;
        history.replaceState(history.state, '', `#${heading.id}`);
        heading.scrollIntoView({ block: 'start', behavior: 'smooth' });
        try {
          await navigator.clipboard.writeText(url);
          link.dataset.copied = '';
          link.setAttribute('aria-label', done);
          setTimeout(() => {
            delete link.dataset.copied;
            link.setAttribute('aria-label', label);
          }, 1600);
        } catch {
          // Clipboard unavailable: the hash in the address bar is enough.
        }
      });
      heading.append(link);
    }
  };
  document.addEventListener('astro:page-load', addHeadingAnchors);

  // Click to enlarge images that the column shows smaller than they are
  // (wide screenshots, tall captures capped at 520px), in a native <dialog>.
  const largestSource = (img: HTMLImageElement) => {
    const candidates = (img.getAttribute('srcset') ?? '')
      .split(',')
      .map((part) => part.trim().split(/\s+/))
      .filter(([url]) => url)
      .map(([url, size]) => ({ url, w: parseInt(size ?? '', 10) || 0 }))
      .sort((a, b) => b.w - a.w);
    return candidates[0]?.url ?? img.currentSrc ?? img.src;
  };

  let viewer: HTMLDialogElement | undefined;
  const openViewer = (img: HTMLImageElement) => {
    if (!viewer || !viewer.isConnected) {
      viewer = document.createElement('dialog');
      viewer.className = 'aw-zoom-viewer';
      viewer.innerHTML = '<img alt="" /><p></p>';
      // Any click or key closes it: there is nothing else to do in the viewer.
      viewer.addEventListener('click', () => viewer!.close());
      viewer.addEventListener('close', () => document.documentElement.classList.remove('aw-modal-open'));
      document.body.append(viewer);
    }
    const big = viewer.querySelector('img')!;
    big.src = largestSource(img);
    big.alt = img.alt;
    viewer.querySelector('p')!.textContent = img.alt;
    viewer.setAttribute('aria-label', img.alt || (document.documentElement.lang === 'en' ? 'Image' : 'Imagen'));
    viewer.showModal();
    document.documentElement.classList.add('aw-modal-open');
  };

  const addZoom = () => {
    const label = document.documentElement.lang === 'en' ? 'Enlarge image' : 'Ampliar la imagen';
    const check = (img: HTMLImageElement) => {
      if (img.dataset.zoom !== undefined || img.closest('a, button, .not-prose')) return;
      const shrunk = img.naturalWidth > img.clientWidth * 1.15 || img.naturalHeight > img.clientHeight * 1.15;
      if (!shrunk || !img.clientWidth) return;
      img.dataset.zoom = '';
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', img.alt ? `${label}: ${img.alt}` : label);
      img.addEventListener('click', () => openViewer(img));
      img.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openViewer(img);
        }
      });
    };
    for (const img of document.querySelectorAll<HTMLImageElement>('.aw-prose img')) {
      if (img.complete) check(img);
      else img.addEventListener('load', () => check(img), { once: true });
    }
  };
  document.addEventListener('astro:page-load', addZoom);
</script>
