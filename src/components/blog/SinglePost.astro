---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<section class="mx-auto py-10 sm:py-14 lg:py-16">
  <article>
    <header>
      <div class="mx-auto mb-4 mt-0 flex max-w-3xl flex-col px-4 text-sm text-muted sm:px-6">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={post.publishDate.toISOString()} class="inline-block"
            >{getFormattedDate(post.publishDate)}</time
          >
          {
            post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
              <>
                {' '}
                ·{' '}
                <span class="inline-block">
                  Actualizado <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
                </span>
              </>
            )
          }
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min de lectura
              </>
            )
          }
        </p>
      </div>

      <h1
        class="mx-auto max-w-3xl px-4 font-heading text-4xl font-medium leading-tight tracking-tight text-balance text-heading sm:px-6 md:text-5xl"
      >
        {post.title}
      </h1>
      <p
        class="mx-auto mb-8 mt-4 max-w-3xl px-4 text-lg leading-relaxed text-pretty text-muted sm:px-6 md:text-xl"
      >
        {post.excerpt}
      </p>

      {
        post.image ? (
          <Image
            src={post.image}
            class="mx-auto mb-6 aspect-[900/506] max-w-full border border-line object-cover sm:rounded-xl lg:max-w-[900px]"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.imageAlt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    <div
      class="aw-prose mx-auto mt-8 max-w-3xl px-6"
    >
      <slot />
    </div>
    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>
</section>
