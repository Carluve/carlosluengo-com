---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import PostCover from '~/components/blog/PostCover.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<div class="aw-read-progress" aria-hidden="true"></div>
<section class="mx-auto max-w-3xl py-2">
  <article>
    <header>
      <div class="mb-4 flex flex-col text-[13px] text-muted">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={post.publishDate.toISOString()} class="inline-block"
            >{getFormattedDate(post.publishDate)}</time
          >
          {
            post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
              <>
                {' '}
                ·{' '}
                <span class="inline-block">
                  Actualizado <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
                </span>
              </>
            )
          }
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min de lectura
              </>
            )
          }
        </p>
      </div>

      <h1 class="font-heading text-3xl font-semibold leading-tight tracking-tight text-balance text-heading md:text-4xl">
        {post.title}
      </h1>
      <p class="mb-6 mt-3 text-[15px] leading-relaxed text-pretty text-muted">{post.excerpt}</p>

      {
        post.image ? (
          <div class="mb-6 overflow-hidden rounded-xl border border-line" transition:name={`cover-${post.slug}`}>
            <Image
              src={post.image}
              class="aspect-[900/506] w-full object-cover"
              widths={[400, 900]}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.imageAlt || ''}
              width={900}
              height={506}
              format="webp"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        ) : (
          <div class="mb-6 overflow-hidden rounded-xl border border-line" transition:name={`cover-${post.slug}`}>
            <PostCover post={post} class="h-40 w-full sm:h-48" />
          </div>
        )
      }
    </header>
    <div class="aw-prose mt-8">
      <slot />
    </div>
    <div class="mt-8 flex flex-col justify-between sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>
</section>
