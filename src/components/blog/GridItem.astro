---
import { getLang, useTranslations, categoryLabel } from '~/i18n/utils';
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';
import PostCover from '~/components/blog/PostCover.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  lang={post.lang && post.lang !== lang ? post.lang : undefined}
  class="aw-card aw-spotlight aw-reveal group flex h-full flex-col overflow-hidden"
>
  <a
    class="block overflow-hidden bg-primary/5"
    href={link || undefined}
    tabindex="-1"
    aria-hidden="true"
    transition:name={`cover-${post.slug}`}
  >
    {
      image ? (
        <Image
          src={image}
          class="aspect-[16/10] w-full object-cover"
          widths={[400, 900]}
          width={900}
          height={506}
          sizes="(max-width: 900px) 400px, 900px"
          alt=""
          format="webp"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <PostCover post={post} class="aspect-[16/10] w-full" />
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-5">
    {post.category && <p class="aw-eyebrow">{categoryLabel(post.category.slug, post.category.title, lang)}</p>}
    <h3 class="mt-2 font-heading text-xl font-medium leading-snug text-heading">
      {
        link ? (
          <a class="inline-block hover:text-link" href={link}>
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
      {
        post.lang && post.lang !== lang && (
          <span
            class="ml-2 inline-block rounded border border-line px-1.5 py-px align-middle text-[0.65rem] font-semibold uppercase tracking-wider text-muted"
            title={lang === 'es' ? 'Artículo en inglés' : 'Post in Spanish'}
          >
            {post.lang}
          </span>
        )
      }
    </h3>

    {post.excerpt && <p class="mt-2 text-sm leading-relaxed text-muted">{post.excerpt}</p>}
    <p class="mt-auto pt-4 text-xs text-muted">
      <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate, lang)}</time>
      {
        post.readingTime && (
          <span>
            {' '}
            · {post.readingTime} {t('blog.readingTime')}
          </span>
        )
      }
    </p>
  </div>
</article>
