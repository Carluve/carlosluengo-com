---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article class="aw-card flex h-full flex-col overflow-hidden">
  {
    image && (
      <div class="bg-primary/5">
        {link ? (
          <a href={link}>
            <Image
              src={image}
              class="aspect-[16/10] w-full object-cover"
              widths={[400, 900]}
              width={900}
              height={506}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class="aspect-[16/10] w-full object-cover"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        )}
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-heading text-xl font-medium leading-snug text-heading">
      {
        link ? (
          <a class="inline-block hover:text-link" href={link}>
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-muted">{post.excerpt}</p>
  </div>
</article>
