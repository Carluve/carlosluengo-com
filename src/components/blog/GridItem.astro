---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';
import PostCover from '~/components/blog/PostCover.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article class="aw-card aw-spotlight aw-reveal group flex h-full flex-col overflow-hidden">
  <a
    class="block overflow-hidden bg-primary/5"
    href={link || undefined}
    tabindex="-1"
    aria-hidden="true"
    transition:name={`cover-${post.slug}`}
  >
    {
      image ? (
        <Image
          src={image}
          class="aspect-[16/10] w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-[cubic-bezier(0.22,1,0.36,1)] motion-safe:group-hover:scale-[1.03]"
          widths={[400, 900]}
          width={900}
          height={506}
          sizes="(max-width: 900px) 400px, 900px"
          alt=""
          format="webp"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <PostCover post={post} class="aspect-[16/10] w-full" />
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-5">
    {post.category && <p class="aw-eyebrow">{post.category.title}</p>}
    <h3 class="mt-2 font-heading text-xl font-medium leading-snug text-heading">
      {
        link ? (
          <a class="inline-block hover:text-link" href={link}>
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-muted">{post.excerpt}</p>
  </div>
</article>
