---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article class="aw-card h-full overflow-hidden motion-safe:transition motion-safe:duration-200 hover:border-primary/40 motion-reduce:transition-none">
  <div class:list={['grid h-full', image ? 'md:grid-cols-[16rem_1fr]' : '']}>
    {
      image &&
        (link ? (
          <a class="block bg-primary/5" href={link} tabindex="-1" aria-hidden="true">
            <Image
              src={image}
              class="aspect-[16/10] h-full w-full object-cover md:aspect-auto md:min-h-full"
              widths={[400, 640]}
              width={640}
              height={400}
              sizes="(max-width: 768px) 100vw, 256px"
              alt=""
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class="aspect-[16/10] h-full w-full object-cover"
            widths={[400, 640]}
            width={640}
            height={400}
            sizes="(max-width: 768px) 100vw, 256px"
            alt={post.imageAlt || ''}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        ))
    }
    <div class="flex flex-col p-5 sm:p-6">
      <p class="text-sm text-muted">
        <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
        {post.category && (
          <>
            <span aria-hidden="true"> · </span>
            <a class="hover:text-link hover:underline" href={getPermalink(post.category.slug, 'category')}>
              {post.category.title}
            </a>
          </>
        )}
        {post.readingTime && (
          <>
            <span aria-hidden="true"> · </span>
            <span>{post.readingTime} min de lectura</span>
          </>
        )}
      </p>
      <h2 class="mt-2 font-heading text-2xl font-medium leading-snug tracking-tight text-heading">
        {
          link ? (
            <a class="hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary" href={link}>
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
      </h2>
      {post.excerpt && <p class="mt-2 text-pretty leading-relaxed text-muted">{post.excerpt}</p>}
      {
        post.tags && Array.isArray(post.tags) && post.tags.length > 0 && (
          <footer class="mt-4">
            <PostTags tags={post.tags} />
          </footer>
        )
      }
    </div>
  </div>
</article>
