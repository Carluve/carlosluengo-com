---
import { getLang, localizePath, useTranslations, categoryLabel } from '~/i18n/utils';
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import PostCover from '~/components/blog/PostCover.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  lang={post.lang && post.lang !== lang ? post.lang : undefined}
  class="aw-card aw-spotlight aw-reveal group h-full overflow-hidden motion-safe:transition motion-safe:duration-200 hover:border-primary/40 motion-reduce:transition-none"
>
  <div class="grid h-full md:grid-cols-[16rem_1fr]">
    <a
      class="block overflow-hidden bg-primary/5"
      href={link || undefined}
      tabindex="-1"
      aria-hidden="true"
      transition:name={`cover-${post.slug}`}
    >
      {
        image ? (
          <Image
            src={image}
            class="aspect-[16/10] h-full w-full object-cover md:aspect-auto md:min-h-full"
            widths={[400, 640]}
            width={640}
            height={400}
            sizes="(max-width: 768px) 100vw, 256px"
            alt=""
            format="webp"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <PostCover post={post} class="aspect-[16/10] h-full w-full md:aspect-auto md:min-h-44" />
        )
      }
    </a>
    <div class="flex flex-col p-5 sm:p-6">
      <p class="text-sm text-muted">
        <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate, lang)}</time>
        {
          post.category && (
            <>
              <span aria-hidden="true"> · </span>
              <a
                class="hover:text-link hover:underline"
                href={localizePath(getPermalink(post.category.slug, 'category'), lang)}
              >
                {categoryLabel(post.category.slug, post.category.title, lang)}
              </a>
            </>
          )
        }
        {
          post.readingTime && (
            <>
              <span aria-hidden="true"> · </span>
              <span>
                {post.readingTime} {t('blog.readingTime')}
              </span>
            </>
          )
        }
      </p>
      <h2 class="mt-2 font-heading text-2xl font-medium leading-snug tracking-tight text-heading">
        {
          link ? (
            <a
              class="hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              href={link}
            >
              {post.title}
            </a>
          ) : (
            post.title
          )
        }
        {
          post.lang && post.lang !== lang && (
            <span
              class="ml-2 inline-block rounded border border-line px-1.5 py-px align-middle text-[0.65rem] font-semibold uppercase tracking-wider text-muted"
              title={lang === 'es' ? 'Artículo en inglés' : 'Post in Spanish'}
            >
              {post.lang}
            </span>
          )
        }
      </h2>
      {post.excerpt && <p class="mt-2 text-pretty leading-relaxed text-muted">{post.excerpt}</p>}
      {
        post.tags && Array.isArray(post.tags) && post.tags.length > 0 && (
          <footer class="mt-4">
            <PostTags tags={post.tags} />
          </footer>
        )
      }
    </div>
  </div>
</article>
