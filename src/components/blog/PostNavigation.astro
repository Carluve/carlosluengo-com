---
/**
 * Previous / next post at the end of an article. Cards use the same hover as
 * the rest of the site (uiarc.dev Card, MIT).
 */
import { Icon } from 'astro-icon/components';
import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  prev?: Post;
  next?: Post;
}

const { prev, next } = Astro.props;
const items = [
  prev && { post: prev, label: 'Anterior', icon: 'tabler:arrow-left', align: 'text-left' },
  next && { post: next, label: 'Siguiente', icon: 'tabler:arrow-right', align: 'sm:text-right' },
].filter(Boolean) as Array<{ post: Post; label: string; icon: string; align: string }>;
---

{
  items.length > 0 && (
    <nav class="mx-auto mt-12 max-w-3xl px-4 sm:px-6" aria-label="Más entradas">
      <ul class="grid gap-4 sm:grid-cols-2">
        {items.map(({ post, label, icon, align }) => (
          <li class:list={[label === 'Siguiente' && items.length === 1 && 'sm:col-start-2']}>
            <a
              href={getPermalink(post.permalink, 'post')}
              rel={label === 'Anterior' ? 'prev' : 'next'}
              class:list={[
                'aw-card aw-spotlight group flex h-full flex-col gap-1 p-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary',
                align,
              ]}
            >
              <span
                class:list={[
                  'inline-flex items-center gap-1 text-xs font-medium uppercase tracking-[0.14em] text-link',
                  label === 'Siguiente' && 'sm:justify-end',
                ]}
              >
                {label === 'Anterior' && (
                  <Icon name={icon} class="h-4 w-4 motion-safe:transition-transform group-hover:-translate-x-0.5" />
                )}
                {label}
                {label === 'Siguiente' && (
                  <Icon name={icon} class="h-4 w-4 motion-safe:transition-transform group-hover:translate-x-0.5" />
                )}
              </span>
              <span class="font-heading text-lg font-medium leading-snug text-heading group-hover:text-link">
                {post.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
