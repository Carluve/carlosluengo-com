---
import { getLang, localizePath, useTranslations, categoryLabel } from '~/i18n/utils';
/**
 * Category filter and a small "posts per year" chart for the blog index.
 * Static SVG and links only: no client JavaScript.
 */
import { fetchPosts } from '~/utils/blog';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

export interface Props {
  /** Slug of the category being shown, if any. */
  active?: string;
}

const { active } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
const posts = await fetchPosts();

const categories = new Map<string, { title: string; count: number }>();
for (const post of posts) {
  if (!post.category) continue;
  const entry = categories.get(post.category.slug) ?? { title: post.category.title, count: 0 };
  entry.count++;
  categories.set(post.category.slug, entry);
}
const chips = [...categories.entries()].sort((a, b) => b[1].count - a[1].count);

// The active pill keeps one transition name across pages, so client-side
// navigation slides it to the new chip (EasyUI Animated Tabs, MIT).
const chipClass =
  'relative isolate inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary';
---

<div class="-mt-4 mb-10">
  <nav aria-label={t('blog.categories')}>
    <ul class="flex flex-wrap gap-2">
      <li>
        <a
          href={localizePath(getBlogPermalink(), lang)}
          aria-current={!active ? 'page' : undefined}
          class:list={[
            chipClass,
            !active
              ? 'border-primary text-white'
              : 'border-line bg-surface text-default hover:border-primary/40 hover:text-link',
          ]}
        >
          {
            !active && (
              <span
                class="absolute -inset-px -z-10 rounded-full bg-primary"
                transition:name="aw-chip-pill"
                aria-hidden="true"
              />
            )
          }
          {t('blog.all')}
          <span class="tabular-nums opacity-70">{posts.length}</span>
        </a>
      </li>
      {
        chips.map(([slug, { title, count }]) => (
          <li>
            <a
              href={localizePath(getPermalink(slug, 'category'), lang)}
              aria-current={active === slug ? 'page' : undefined}
              class:list={[
                chipClass,
                active === slug
                  ? 'border-primary text-white'
                  : 'border-line bg-surface text-default hover:border-primary/40 hover:text-link',
              ]}
            >
              {active === slug && (
                <span
                  class="absolute -inset-px -z-10 rounded-full bg-primary"
                  transition:name="aw-chip-pill"
                  aria-hidden="true"
                />
              )}
              {categoryLabel(slug, title, lang)} <span class="tabular-nums opacity-70">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
