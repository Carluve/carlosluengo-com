---
/**
 * Compact navigation box for the posts of a series: which part this is, a
 * link to the index and the previous and next parts by number.
 * Renders nothing for posts that are not in any series (src/data/series.ts).
 */
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { parteDeSlug } from '~/data/series';

export interface Props {
  slug: string;
  /** 'top' sits under the cover; 'bottom' closes the article. */
  position?: 'top' | 'bottom';
  class?: string;
}

const { slug, position = 'top', class: className = '' } = Astro.props;
const found = parteDeSlug(slug);
const serie = found?.serie;
const current = found?.parte;
const serieParte = (n: number) => serie?.partes.find((p) => p.part === n);
const prev = current ? serieParte(current.part - 1) : undefined;
const next = current ? serieParte(current.part + 1) : undefined;
const link = (s: string) => getPermalink(s, 'post');
---

{
  current && (
    <nav
      aria-label={`${serie!.name}, ${position === 'top' ? 'inicio' : 'final'} del artículo`}
      class:list={['mx-auto max-w-3xl px-4 sm:px-6', className]}
    >
      <div class="rounded-xl border border-primary/25 bg-primary/5 p-4 text-sm dark:border-primary/35 dark:bg-primary/10">
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
          <p class="font-medium text-heading">
            <span class="aw-eyebrow mr-1">{serie!.name}</span>
            <span class="text-muted" aria-hidden="true">
              ·
            </span>{' '}
            parte {current.part} de {serie!.total}
          </p>
          <a
            href={getPermalink(serie!.path)}
            class="inline-flex items-center gap-1 font-medium text-link underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            Ver todos los capítulos
            <Icon name="tabler:list-numbers" class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
        {position === 'top' && (
          <ol class="cl-serie-steps mt-3 flex gap-1" aria-label={`${serie!.name}: capítulos`}>
            {serie!.partes.map((p) => {
              const state = p.part === current.part ? 'current' : p.part < current.part ? 'done' : 'todo';
              const cls = [
                'block h-1.5 rounded-full transition-all duration-200',
                state === 'current' ? 'bg-primary' : state === 'done' ? 'bg-primary/55' : 'bg-primary/15',
                p.slug && state !== 'current' ? 'hover:h-2.5 hover:bg-primary/80' : '',
              ].join(' ');
              return (
                <li class="flex-1">
                  {p.slug && state !== 'current' ? (
                    <a href={link(p.slug)} title={`Parte ${p.part}: ${p.title}`} class={cls}>
                      <span class="sr-only">{`Parte ${p.part}: ${p.title}`}</span>
                    </a>
                  ) : (
                    <span
                      class={cls}
                      title={`Parte ${p.part}: ${p.title}`}
                      aria-current={state === 'current' ? 'step' : undefined}
                    >
                      <span class="sr-only">{`Parte ${p.part}: ${p.title}`}</span>
                    </span>
                  )}
                </li>
              );
            })}
          </ol>
        )}
        {(prev || next) && (
          <div class="mt-3 grid gap-2 border-t border-primary/15 pt-3 sm:grid-cols-2">
            <div>
              {prev && prev.slug && (
                <a
                  href={link(prev.slug)}
                  rel="prev"
                  class="group flex items-start gap-1.5 text-default hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                >
                  <Icon name="tabler:arrow-left" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
                  <span>
                    <span class="block text-xs text-muted">Parte {prev.part}</span>
                    <span class="group-hover:underline">{prev.title}</span>
                  </span>
                </a>
              )}
            </div>
            <div class="sm:text-right">
              {next &&
                (next.slug ? (
                  <a
                    href={link(next.slug)}
                    rel="next"
                    class="group flex items-start gap-1.5 text-default hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:flex-row-reverse"
                  >
                    <Icon name="tabler:arrow-right" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
                    <span>
                      <span class="block text-xs text-muted">Parte {next.part}</span>
                      <span class="group-hover:underline">{next.title}</span>
                    </span>
                  </a>
                ) : (
                  <p class="flex items-start gap-1.5 text-muted sm:flex-row-reverse">
                    <Icon name="tabler:clock" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
                    <span>
                      <span class="block text-xs">Parte {next.part} · próximamente</span>
                      <span>{next.title}</span>
                    </span>
                  </p>
                ))}
            </div>
          </div>
        )}
      </div>
    </nav>
  )
}
