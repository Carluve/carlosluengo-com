---
import { getLang, localizePath, useTranslations } from '~/i18n/utils';
import { APP_BLOG } from 'astrowind:config';

import { getRelatedPosts } from '~/utils/blog';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import type { Post } from '~/types';
import { getBlogPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);

const relatedPosts = post.tags ? await getRelatedPosts(post, 3) : [];
---

{
  APP_BLOG.isRelatedPostsEnabled ? (
    <BlogHighlightedPosts
      classes={{
        container:
          'pt-0 lg:pt-0 md:pt-0 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
      }}
      title={t('blog.related')}
      linkText={t('blog.seeBlog')}
      linkUrl={localizePath(getBlogPermalink(), lang)}
      postIds={relatedPosts.map((post) => post.id)}
    />
  ) : null
}
