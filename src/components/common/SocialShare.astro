---
import { getLang, useTranslations } from '~/i18n/utils';
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);
---

<aw-social-share class={className}>
  <span class="mr-1 text-sm font-medium text-muted">{t('blog.share')}</span>
  <button
    type="button"
    class="rounded-md p-1.5 text-muted transition-colors hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
    title={lang === 'en' ? 'Share on X' : 'Compartir en X'}
    aria-label={lang === 'en' ? 'Share on X' : 'Compartir en X'}
    data-aw-social-share="twitter"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-x" class="h-5 w-5" aria-hidden="true" />
  </button>
  <button
    type="button"
    class="rounded-md p-1.5 text-muted transition-colors hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
    title={lang === 'en' ? 'Share on LinkedIn' : 'Compartir en LinkedIn'}
    aria-label={lang === 'en' ? 'Share on LinkedIn' : 'Compartir en LinkedIn'}
    data-aw-social-share="linkedin"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-linkedin" class="h-5 w-5" aria-hidden="true" />
  </button>
  <button
    type="button"
    class="rounded-md p-1.5 text-muted transition-colors hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
    title={lang === 'en' ? 'Share on WhatsApp' : 'Compartir en WhatsApp'}
    aria-label={lang === 'en' ? 'Share on WhatsApp' : 'Compartir en WhatsApp'}
    data-aw-social-share="whatsapp"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:brand-whatsapp" class="h-5 w-5" aria-hidden="true" />
  </button>
  <button
    type="button"
    class="rounded-md p-1.5 text-muted transition-colors hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
    title={lang === 'en' ? 'Share by email' : 'Compartir por correo'}
    aria-label={lang === 'en' ? 'Share by email' : 'Compartir por correo'}
    data-aw-social-share="mail"
    data-aw-url={url}
    data-aw-text={text}
    ><Icon name="tabler:mail" class="h-5 w-5" aria-hidden="true" />
  </button>
  <button
    type="button"
    class="aw-share-copy rounded-md p-1.5 text-muted transition-colors hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
    title={t('blog.copyLink')}
    aria-label={t('blog.copyLink')}
    data-aw-copy-link={url}
    data-label={t('blog.copyLink')}
    data-done={t('blog.linkCopied')}
    ><Icon name="tabler:link" class="h-5 w-5" aria-hidden="true" /><Icon
      name="tabler:check"
      class="h-5 w-5"
      aria-hidden="true"
    />
  </button>
  <button
    type="button"
    class="rounded-md p-1.5 text-muted transition-colors hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
    title={t('blog.nativeShare')}
    aria-label={t('blog.nativeShare')}
    data-aw-native-share
    data-aw-url={url}
    data-aw-text={text}
    hidden
    ><Icon name="tabler:share-2" class="h-5 w-5" aria-hidden="true" />
  </button>
  <span class="sr-only" aria-live="polite" data-aw-share-status></span>
</aw-social-share>

<script>
  const SHARE_URLS: Record<string, (url: string, text: string) => string> = {
    twitter: (url, text) => `https://twitter.com/intent/tweet?url=${url}&text=${text}`,
    linkedin: (url, text) => `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${text}`,
    whatsapp: (_url, text) => `https://wa.me/?text=${text}%20${_url}`,
    mail: (url, text) => `mailto:?subject=%22${text}%22&body=${text}%20${url}`,
  };

  class AwSocialShare extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll<HTMLElement>('[data-aw-social-share]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const network = btn.getAttribute('data-aw-social-share') ?? '';
          const url = encodeURIComponent(btn.getAttribute('data-aw-url') ?? '');
          const text = encodeURIComponent(btn.getAttribute('data-aw-text') ?? '');
          const build = SHARE_URLS[network];
          if (!build) return;

          const link = document.createElement('a');
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.href = build(url, text);
          link.click();
        });
      });

      const status = this.querySelector<HTMLElement>('[data-aw-share-status]');
      const copy = this.querySelector<HTMLElement>('[data-aw-copy-link]');
      copy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copy.dataset.awCopyLink ?? location.href);
        } catch {
          return;
        }
        copy.dataset.copied = '';
        copy.setAttribute('aria-label', copy.dataset.done ?? '');
        if (status) status.textContent = copy.dataset.done ?? '';
        setTimeout(() => {
          delete copy.dataset.copied;
          copy.setAttribute('aria-label', copy.dataset.label ?? '');
          if (status) status.textContent = '';
        }, 1800);
      });

      // The system share sheet, where there is one (phones, Safari, Edge).
      const native = this.querySelector<HTMLElement>('[data-aw-native-share]');
      if (native && 'share' in navigator) {
        native.hidden = false;
        native.addEventListener('click', () => {
          navigator.share({ title: native.dataset.awText, url: native.dataset.awUrl }).catch(() => {
            // Dismissed by the visitor.
          });
        });
      }
    }
  }

  if (!customElements.get('aw-social-share')) {
    customElements.define('aw-social-share', AwSocialShare);
  }
</script>

<style>
  aw-social-share {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .aw-share-copy > :global(svg:last-child),
  .aw-share-copy[data-copied] > :global(svg:first-child) {
    display: none;
  }
  .aw-share-copy[data-copied] > :global(svg:last-child) {
    display: block;
    color: var(--aw-color-primary);
  }
</style>
