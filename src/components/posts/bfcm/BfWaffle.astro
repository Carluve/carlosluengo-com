---
/** 10,000 requests as a grid: how many came from a personal agent in early October vs the shopping week. */
import './bfcm.css';
import { RADAR_URL, share } from '~/data/bfcm-2026';

const base = Math.round(share.baseline * 100); // per 10,000
const now = Math.round(share.now * 100);
---

<bf-waffle class="bf not-prose block" data-base={base} data-now={now}>
  <p class="bf__eyebrow">Para no exagerar</p>
  <p class="bf__title">De cada 10.000 peticiones que ve Cloudflare, ¿cuántas son de un agente que compra?</p>
  <div class="bf__seg" role="group" aria-label="Periodo">
    <button type="button" data-k="base" aria-pressed="false">1–7 de octubre</button>
    <button type="button" data-k="now" aria-pressed="true">Semana del Black Friday</button>
  </div>
  <div class="bf-waffle__wrap">
    <canvas
      width="600"
      height="300"
      role="img"
      aria-label={`Rejilla de 10.000 peticiones: ${now} son de agentes personales (antes ${base})`}></canvas>
    <p class="bf-waffle__count"><span data-count>{now}</span> <small>de 10.000</small></p>
  </div>
  <p class="bf__sub">
    Cada punto es una petición. El crecimiento es enorme en porcentaje (+{share.change} %), pero sobre una base mínima: hoy
    es <strong>1 de cada 2.000</strong> peticiones. La tendencia es lo que importa.
  </p>
  <p class="bf__source">
    Fuente: <a href={RADAR_URL} target="_blank" rel="noopener">Cloudflare Radar</a> (cuota de peticiones de agentes personales
    sobre todas las peticiones, humanas y de bots: {share.baseline.toLocaleString('es-ES')} % → {
      share.now.toLocaleString('es-ES')
    } %).
  </p>
</bf-waffle>

<style>
  .bf-waffle__wrap {
    position: relative;
    margin-top: 0.9rem;
  }
  canvas {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.6rem;
  }
  .bf-waffle__count {
    position: absolute;
    right: 0.75rem;
    top: 0.6rem;
    border-radius: 0.6rem;
    background: var(--aw-color-surface);
    border: 1px solid var(--aw-color-border);
    padding: 0.3rem 0.7rem;
    font-size: 1.5rem;
    font-weight: 750;
    color: var(--aw-color-primary);
    font-variant-numeric: tabular-nums;
  }
  .bf-waffle__count small {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--aw-color-text-muted);
  }
</style>

<script>
  class BfWaffle extends HTMLElement {
    cells: number[] = [];
    connectedCallback() {
      const canvas = this.querySelector('canvas')!;
      const counter = this.querySelector<HTMLElement>('[data-count]')!;
      const base = Number(this.dataset.base);
      const now = Number(this.dataset.now);
      // Fixed, spread-out positions so the agent dots are scattered, not clustered.
      const picks = [3410, 7311, 4642, 9077, 2988];
      let current = now;
      let pulse = 0;
      const draw = () => {
        const dpr = window.devicePixelRatio || 1;
        const w = canvas.clientWidth || 600;
        const cols = 125;
        const rows = 80; // 10,000 cells
        const cell = w / cols;
        const h = cell * rows;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        const ctx = canvas.getContext('2d')!;
        ctx.scale(dpr, dpr);
        const css = getComputedStyle(this);
        const dot = css.getPropertyValue('--bf-muted-bar').trim() || '#b8c4d6';
        const primary = css.getPropertyValue('--bf-muse').trim() || '#0161ef';
        ctx.globalAlpha = 0.45;
        ctx.fillStyle = dot;
        const r = Math.max(0.6, cell * 0.28);
        for (let i = 0; i < cols * rows; i++) {
          const x = (i % cols) * cell + cell / 2;
          const y = Math.floor(i / cols) * cell + cell / 2;
          ctx.beginPath();
          ctx.arc(x, y, r, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
        picks.slice(0, current).forEach((i) => {
          const x = (i % cols) * cell + cell / 2;
          const y = Math.floor(i / cols) * cell + cell / 2;
          ctx.strokeStyle = primary;
          ctx.lineWidth = 2;
          ctx.globalAlpha = 0.25 + 0.25 * Math.abs(Math.sin(pulse));
          ctx.beginPath();
          ctx.arc(x, y, cell * 3.2, 0, Math.PI * 2);
          ctx.stroke();
          ctx.globalAlpha = 1;
          ctx.fillStyle = primary;
          ctx.beginPath();
          ctx.arc(x, y, Math.max(2.5, cell * 0.9), 0, Math.PI * 2);
          ctx.fill();
        });
      };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let raf = 0;
      const loop = () => {
        pulse += 0.03;
        draw();
        raf = requestAnimationFrame(loop);
      };
      const io = new IntersectionObserver((e) => {
        cancelAnimationFrame(raf);
        if (e[0].isIntersecting && !reduce) loop();
        else draw();
      });
      io.observe(canvas);
      new ResizeObserver(() => draw()).observe(canvas);
      this.querySelectorAll<HTMLButtonElement>('[data-k]').forEach((b) =>
        b.addEventListener('click', () => {
          this.querySelectorAll('[data-k]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          current = b.dataset.k === 'base' ? base : now;
          counter.textContent = String(current);
          draw();
        })
      );
      draw();
    }
  }
  if (!customElements.get('bf-waffle')) customElements.define('bf-waffle', BfWaffle);
</script>
