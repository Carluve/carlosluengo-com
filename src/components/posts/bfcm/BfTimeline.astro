---
/** Vertical timeline from Muse's launch to Black Friday; each milestone opens its detail and source. */
import './bfcm.css';
import { timeline } from '~/data/bfcm-2026';

const last = timeline.length - 1;
---

<bf-timeline class="bf not-prose block">
  <p class="bf__eyebrow">De septiembre al Black Friday</p>
  <p class="bf__title">Once semanas que cambiaron quién hace la compra</p>
  <ol class="bf-tl">
    {
      timeline.map((e, i) => (
        <li class="bf-tl__item" data-open={i === last ? '' : undefined}>
          <button type="button" class="bf-tl__head" aria-expanded={i === last ? 'true' : 'false'}>
            <span class="bf-tl__pin" aria-hidden="true" />
            <span class="bf-tl__date">{e.date}</span>
            <span class="bf-tl__label">{e.label}</span>
            <span class="bf-tl__chev" aria-hidden="true">
              ›
            </span>
          </button>
          <div class="bf-tl__body">
            <p>{e.detail}</p>
            <a href={e.href} target="_blank" rel="noopener">
              Fuente: {e.source} ↗
            </a>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="bf__source">Pulsa cada hito para ver el detalle y la fuente.</p>
</bf-timeline>

<style>
  .bf-tl {
    position: relative;
    margin-top: 1rem;
    display: grid;
    gap: 0.15rem;
  }
  .bf-tl::before {
    content: '';
    position: absolute;
    left: 0.95rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 2px;
    background: var(--aw-color-border);
  }
  .bf-tl__head {
    position: relative;
    display: grid;
    grid-template-columns: 1.9rem 4.2rem minmax(0, 1fr) 1rem;
    align-items: center;
    width: 100%;
    text-align: left;
    padding: 0.45rem 0.4rem 0.45rem 0;
    border-radius: 0.6rem;
    cursor: pointer;
  }
  .bf-tl__head:hover {
    background: var(--bf-track);
  }
  .bf-tl__pin {
    justify-self: center;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 999px;
    background: var(--aw-color-surface);
    border: 2px solid var(--bf-muted-bar);
    transition:
      background 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }
  .bf-tl__date {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--aw-color-text-muted);
  }
  .bf-tl__label {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--aw-color-text-heading);
  }
  .bf-tl__chev {
    color: var(--aw-color-text-muted);
    transition: transform 0.2s;
  }
  .bf-tl__body {
    display: none;
    margin: 0.1rem 0 0.5rem 6.1rem;
    border-radius: 0.7rem;
    background: var(--bf-track);
    padding: 0.65rem 0.85rem;
    font-size: 0.88rem;
  }
  .bf-tl__body a {
    display: inline-block;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: var(--aw-color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .bf-tl__item[data-open] .bf-tl__body {
    display: block;
    animation: bf-fade 0.25s ease both;
  }
  .bf-tl__item[data-open] .bf-tl__pin {
    background: var(--bf-muse);
    border-color: var(--bf-muse);
    transform: scale(1.25);
  }
  .bf-tl__item[data-open] .bf-tl__chev {
    transform: rotate(90deg);
  }
  @media (max-width: 520px) {
    .bf-tl__head {
      grid-template-columns: 1.9rem 3.6rem minmax(0, 1fr) 1rem;
    }
    .bf-tl__body {
      margin-left: 1.9rem;
    }
  }
  @keyframes bf-fade {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
  }
</style>

<script>
  class BfTimeline extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll<HTMLElement>('.bf-tl__item').forEach((item) => {
        const head = item.querySelector<HTMLButtonElement>('.bf-tl__head')!;
        head.addEventListener('click', () => {
          const open = item.hasAttribute('data-open');
          item.toggleAttribute('data-open', !open);
          head.setAttribute('aria-expanded', String(!open));
        });
      });
    }
  }
  if (!customElements.get('bf-timeline')) customElements.define('bf-timeline', BfTimeline);
</script>
