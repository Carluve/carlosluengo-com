---
/** Four headline numbers from Cloudflare Radar's BFCM 2026 page, counting up when they scroll into view. */
import './bfcm.css';
import { RADAR_URL, RADAR_READ, share, allowed, growth } from '~/data/bfcm-2026';

const all = growth.find((g) => g.key === 'all')!;
const fmt = (n: number, d = 0) => n.toLocaleString('es-ES', { minimumFractionDigits: d, maximumFractionDigits: d });

const tiles = [
  {
    value: share.change,
    prefix: '+',
    suffix: ' %',
    decimals: 0,
    label: 'cuota de peticiones de agentes personales',
    note: `del ${fmt(share.baseline, 2)} % al ${fmt(share.now, 2)} % de todo lo que ve Cloudflare`,
  },
  {
    value: all.traffic!,
    prefix: '+',
    suffix: ' %',
    decimals: 0,
    label: 'tráfico total de agentes',
    note: 'navegar, añadir al carrito y pagar',
  },
  {
    value: all.purchases!,
    prefix: '+',
    suffix: ' %',
    decimals: 0,
    label: 'peticiones de compra',
    note: 'páginas de carrito, pago y compra',
  },
  {
    value: allowed.now,
    prefix: '',
    suffix: ' %',
    decimals: 2,
    label: 'peticiones de agentes que pasan',
    note: `sin bloqueo ni desafío; el ${fmt(allowed.blockedOrChallenged, 2)} % restante sí lo tiene`,
  },
];
---

<bf-stats class="bf not-prose block">
  <p class="bf__eyebrow">Cloudflare Radar · últimos 7 días frente al 1–7 de octubre</p>
  <p class="bf__title">Los agentes personales en el fin de semana del Black Friday</p>
  <div class="bf-stats__grid">
    {
      tiles.map((t) => (
        <div class="bf-stats__tile">
          <p
            class="bf-stats__num"
            data-to={t.value}
            data-dec={t.decimals}
            data-prefix={t.prefix}
            data-suffix={t.suffix}
          >
            {t.prefix}
            {fmt(t.value, t.decimals)}
            {t.suffix}
          </p>
          <p class="bf-stats__label">{t.label}</p>
          <p class="bf-stats__note">{t.note}</p>
        </div>
      ))
    }
  </div>
  <p class="bf__source">
    Fuente: <a href={RADAR_URL} target="_blank" rel="noopener">Cloudflare Radar, Black Friday / Cyber Monday 2026</a>.
    Panel en vivo, consultado el {RADAR_READ}.
  </p>
</bf-stats>

<style>
  .bf-stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }
  @media (min-width: 768px) {
    .bf-stats__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .bf-stats__tile {
    border-radius: 0.8rem;
    background: var(--bf-track);
    padding: 0.9rem 0.9rem 0.8rem;
  }
  .bf-stats__num {
    font-size: clamp(1.45rem, 3.4vw, 2rem);
    white-space: nowrap;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--aw-color-primary);
    font-variant-numeric: tabular-nums;
  }
  :global(:root.dark) .bf-stats__num {
    color: var(--aw-color-accent);
  }
  .bf-stats__label {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--aw-color-text-heading);
    line-height: 1.3;
  }
  .bf-stats__note {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: var(--aw-color-text-muted);
    line-height: 1.35;
  }
</style>

<script>
  class BfStats extends HTMLElement {
    connectedCallback() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const nums = [...this.querySelectorAll<HTMLElement>('[data-to]')];
      const render = (el: HTMLElement, v: number) => {
        const d = Number(el.dataset.dec);
        el.textContent = `${el.dataset.prefix}${v.toLocaleString('es-ES', { minimumFractionDigits: d, maximumFractionDigits: d })}${el.dataset.suffix}`;
      };
      nums.forEach((el) => render(el, 0));
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          const t0 = performance.now();
          const tick = (t: number) => {
            const k = Math.min(1, (t - t0) / 1200);
            const ease = 1 - Math.pow(1 - k, 3);
            nums.forEach((el) => render(el, Number(el.dataset.to) * ease));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        },
        { threshold: 0.4 }
      );
      io.observe(this);
    }
  }
  if (!customElements.get('bf-stats')) customElements.define('bf-stats', BfStats);
</script>
