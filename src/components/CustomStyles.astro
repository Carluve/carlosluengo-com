---
// Inter (UI and body) and Source Serif 4 (headings) come from Astro's Fonts
// API. Colour tokens are the light-gray and blue system: page canvas, white
// cards, and #0161EF as the accent. Dark mode keeps the same blue family.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-source-serif, ui-serif);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(0 74 191);
    --aw-color-accent: rgb(1 97 239);

    --aw-color-text-heading: rgb(28 25 23);
    --aw-color-text-default: rgb(41 37 36);
    --aw-color-text-muted: rgb(120 113 108);
    --aw-color-bg-page: rgb(238 237 234);
    --aw-color-surface: rgb(255 255 255);
    --aw-color-border: rgb(231 229 228);
    --aw-color-link: rgb(1 97 239);

    --aw-color-bg-page-dark: rgb(11 18 32);

    ::selection {
      background-color: rgb(1 97 239 / 18%);
      color: rgb(15 23 42);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-source-serif, ui-serif);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(56 132 255);
    --aw-color-accent: rgb(147 186 255);

    --aw-color-text-heading: rgb(244 247 251);
    --aw-color-text-default: rgb(213 222 234);
    --aw-color-text-muted: rgb(186 198 216);
    --aw-color-bg-page: rgb(11 18 32);
    --aw-color-surface: rgb(17 26 43);
    --aw-color-border: rgb(46 62 88);
    --aw-color-link: rgb(186 210 255);

    ::selection {
      background-color: rgb(1 97 239 / 45%);
      color: rgb(244 247 251);
    }
  }
</style>
