---
import type { Headline as Props } from '~/types';
import { twMerge } from 'tailwind-merge';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  classes = {},
} = Astro.props;

const {
  container: containerClass = 'max-w-3xl',
  title: titleClass = 'text-3xl md:text-4xl',
  subtitle: subtitleClass = 'text-lg',
} = classes;
---

{
  (title || subtitle || tagline) && (
    <div class={twMerge('mb-8 md:mb-12 text-left', containerClass)}>
      {tagline && <p class="aw-eyebrow" set:html={tagline} />}
      {title && (
        <h2
          class={twMerge(
            'mt-2 font-heading text-3xl font-medium leading-tight tracking-tight text-balance text-heading md:text-4xl',
            titleClass
          )}
          set:html={title}
        />
      )}

      {subtitle && (
        <p
          class={twMerge('mt-3 max-w-2xl text-pretty leading-relaxed text-muted', subtitleClass)}
          set:html={subtitle}
        />
      )}
    </div>
  )
}
