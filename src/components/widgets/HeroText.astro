---
import type { CallToAction } from '~/types';
import Button from '~/components/ui/Button.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  /** Small pill above the tagline. */
  badge?: string;
  content?: string;
  callToAction?: string | CallToAction;
  callToAction2?: string | CallToAction;
  callToAction3?: string | CallToAction;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  badge,
  content = await Astro.slots.render('content'),
  callToAction = await Astro.slots.render('callToAction'),
  callToAction2 = await Astro.slots.render('callToAction2'),
  callToAction3 = await Astro.slots.render('callToAction3'),
} = Astro.props;

const actions = [callToAction, callToAction2, callToAction3].filter(Boolean);
---

<section class="relative not-prose">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="border-b border-line pb-10 pt-10 md:pb-14 md:pt-16">
      <div class="max-w-3xl">
        {
          badge && (
            <span class="mb-4 inline-block rounded-full border border-primary/25 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-link">
              {badge}
            </span>
          )
        }
        {tagline && <p class="aw-eyebrow" set:html={tagline} />}
        {
          title && (
            <h1
              class="mt-3 font-heading text-4xl font-medium leading-[1.12] tracking-tight text-balance text-heading md:text-5xl"
              set:html={title}
            />
          )
        }
        {
          subtitle && (
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pretty text-muted md:text-xl" set:html={subtitle} />
          )
        }
        {
          actions.length > 0 && (
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              {actions.map((action, index) => (
                <div class="flex w-full sm:w-auto">
                  {typeof action === 'string' ? (
                    <Fragment set:html={action} />
                  ) : (
                    <Button variant={index === 0 ? 'primary' : 'secondary'} {...action} />
                  )}
                </div>
              ))}
            </div>
          )
        }
        {content && <Fragment set:html={content} />}
      </div>
    </div>
  </div>
</section>
