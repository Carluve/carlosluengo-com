---
/**
 * Career timeline with logos, newest first. Adapted from EasyUI Interactive
 * Timeline (MIT): the line fills as the section scrolls into view and current
 * positions get a pulsing node. Logos keep their colours on light tiles.
 */
import { Image } from 'astro:assets';
import { career, opticalHeight } from '~/data/career';
import { getLang } from '~/i18n/utils';

export interface Props {
  id?: string;
  tagline?: string;
  title?: string;
  subtitle?: string;
}

const lang = getLang(Astro);
const {
  id = 'carrera',
  tagline = lang === 'en' ? 'Career' : 'Trayectoria',
  title = lang === 'en' ? 'Industry and university' : 'Industria y universidad',
  subtitle = lang === 'en' ? 'From the current stage back to the beginning.' : 'De la etapa actual a los inicios.',
} = Astro.props;
const label = {
  now: lang === 'en' ? 'Now' : 'Actualidad',
  industry: lang === 'en' ? 'Industry' : 'Industria',
  academia: lang === 'en' ? 'University' : 'Universidad',
};
---

<section id={id} class="scroll-mt-24">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-16">
    <p class="aw-eyebrow">{tagline}</p>
    <h2 class="mt-2 font-heading text-3xl font-medium tracking-tight text-heading md:text-4xl">{title}</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">{subtitle}</p>

    <ol class="aw-timeline relative mt-10 max-w-3xl">
      <span class="aw-timeline-track" aria-hidden="true"></span>
      <span class="aw-timeline-fill" aria-hidden="true"></span>
      {
        career.map((entry) => (
          <li class="aw-reveal relative grid grid-cols-[2.5rem_1fr] gap-x-4 pb-8 last:pb-0 sm:grid-cols-[2.5rem_11rem_1fr] sm:gap-x-6">
            <span class:list={['aw-timeline-node', entry.current && 'is-current']} aria-hidden="true" />
            <a
              href={entry.url}
              target="_blank"
              rel="noopener noreferrer"
              class="col-start-2 flex h-16 items-center justify-center rounded-xl border border-line bg-white px-4 shadow-[0_1px_2px_rgb(15_23_42/0.04)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:border-white/10 dark:bg-slate-100 sm:h-20"
            >
              <Image
                src={entry.logo}
                alt={entry.name}
                height={opticalHeight(entry.aspect, 26, entry.scale) * 2}
                style={`height:${opticalHeight(entry.aspect, 26, entry.scale)}px;width:auto;max-width:100%`}
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="col-start-2 mt-3 sm:col-start-3 sm:mt-0 sm:self-center">
              <p class="flex flex-wrap items-center gap-2 text-xs font-medium uppercase tracking-[0.14em] text-muted">
                {entry.kind === 'academia' ? label.academia : label.industry}
                {entry.current && (
                  <span class="rounded-full bg-primary/10 px-2 py-0.5 normal-case tracking-normal text-link">
                    {label.now}
                  </span>
                )}
              </p>
              <h3 class="mt-1 font-heading text-xl font-medium text-heading">{entry.name}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">{entry.role[lang]}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .aw-timeline-track,
  .aw-timeline-fill {
    position: absolute;
    left: calc(1.25rem - 1px);
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    border-radius: 2px;
  }
  .aw-timeline-track {
    background: var(--aw-color-border);
  }
  .aw-timeline-fill {
    background: linear-gradient(
      to bottom,
      var(--aw-color-primary),
      color-mix(in srgb, var(--aw-color-primary) 40%, #7dd3fc)
    );
    transform-origin: top;
  }
  .aw-timeline-node {
    grid-row: 1;
    align-self: start;
    justify-self: center;
    margin-top: 1.75rem;
    z-index: 1;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    border: 3px solid var(--aw-color-bg-page);
    background: color-mix(in srgb, var(--aw-color-primary) 45%, var(--aw-color-bg-page));
    box-shadow: 0 0 0 1.5px color-mix(in srgb, var(--aw-color-primary) 60%, transparent);
  }
  .aw-timeline-node.is-current {
    background: var(--aw-color-primary);
    box-shadow: 0 0 0 1px var(--aw-color-primary);
  }
  @media (min-width: 640px) {
    .aw-timeline-node {
      margin-top: 2.25rem;
    }
  }
  @keyframes aw-timeline-grow {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes aw-node-pulse {
    0% {
      box-shadow:
        0 0 0 1px var(--aw-color-primary),
        0 0 0 0 color-mix(in srgb, var(--aw-color-primary) 45%, transparent);
    }
    100% {
      box-shadow:
        0 0 0 1px var(--aw-color-primary),
        0 0 0 10px transparent;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .aw-timeline-node.is-current {
      animation: aw-node-pulse 1.8s ease-out infinite;
    }
    @supports (animation-timeline: view()) {
      .aw-timeline-fill {
        animation: aw-timeline-grow linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 60%;
      }
    }
  }
</style>
