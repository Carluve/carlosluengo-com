---
import { getGithubActivity, type ContributionDay } from '~/data/github-contributions';

interface Props {
  /** Smaller graph for the home page. The developer page uses the full section. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const activity = await getGithubActivity();
const profileUrl = 'https://github.com/Carluve';
const fallbackChart = 'https://ghchart.rshah.org/0161EF/Carluve';

const cell = compact ? 10 : 12;
const gap = compact ? 2 : 3;
const labelWidth = compact ? 0 : 28;
const labelHeight = 18;
const step = cell + gap;

const months = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const dateFormat = new Intl.DateTimeFormat('es', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

interface Cell extends ContributionDay {
  tip: string;
}

interface Week {
  days: Array<Cell | null>;
  month?: string;
}

function tipFor(day: ContributionDay) {
  const when = dateFormat.format(new Date(`${day.date}T00:00:00Z`));
  if (day.count === 0) return `Sin contribuciones el ${when}`;
  if (day.count === 1) return `1 contribución el ${when}`;
  return `${day.count} contribuciones el ${when}`;
}

function weeksWithMonths(days: ContributionDay[]): Week[] {
  const ordered = [...days].sort((a, b) => a.date.localeCompare(b.date));
  const weeks: Array<Array<Cell | null>> = [];
  let current: Array<Cell | null> = [];

  if (ordered[0]) {
    const [year, month, day] = ordered[0].date.split('-').map(Number);
    const weekday = new Date(Date.UTC(year, month - 1, day)).getUTCDay();
    current = Array.from({ length: weekday }, () => null);
  }

  for (const day of ordered) {
    if (current.length === 7) {
      weeks.push(current);
      current = [];
    }
    current.push({ ...day, tip: tipFor(day) });
  }
  if (current.length > 0) {
    while (current.length < 7) current.push(null);
    weeks.push(current);
  }

  const labeled: Week[] = weeks.map((daysInWeek) => ({ days: daysInWeek }));
  const firstDay = labeled[0]?.days.find((day) => day);
  let lastLabeled = -4;
  let seenMonth = -1;
  if (firstDay) {
    labeled[0].month = months[Number(firstDay.date.slice(5, 7)) - 1];
    seenMonth = Number(firstDay.date.slice(5, 7)) - 1;
    lastLabeled = 0;
  }
  labeled.forEach((week, index) => {
    const starter = week.days.find((day) => day && Number(day.date.slice(8, 10)) <= 7);
    if (!starter) return;
    const monthIndex = Number(starter.date.slice(5, 7)) - 1;
    if (monthIndex === seenMonth || index - lastLabeled < 2) return;
    week.month = months[monthIndex];
    seenMonth = monthIndex;
    lastLabeled = index;
  });
  return labeled;
}

const weeks = activity ? weeksWithMonths(activity.contributions) : [];
const width = labelWidth + Math.max(weeks.length, 1) * step;
const height = labelHeight + 7 * step;
const totalLabel = activity ? activity.totalLastYear.toLocaleString('es') : '';
const summary = activity
  ? `${totalLabel} contribuciones en el último año en el perfil de GitHub de Carluve`
  : 'Calendario de contribuciones de Carluve en GitHub';
const Root = compact ? 'div' : 'section';
---

<Root
  class:list={[compact ? 'mt-8' : 'relative not-prose scroll-mt-[72px]']}
  {...compact ? {} : { id: 'github-activity' }}
>
  <div class:list={[compact ? '' : 'mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-16 lg:py-20']}>
    {
      compact ? (
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="font-heading text-lg font-medium text-heading">GitHub Activity</h3>
          {activity && <p class="text-sm text-muted">{totalLabel} contribuciones en el último año</p>}
        </div>
      ) : (
        <>
          <p class="aw-eyebrow">Perfil público</p>
          <h2 class="mt-2 font-heading text-3xl font-medium tracking-tight text-heading md:text-4xl">
            GitHub Activity
          </h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted">
            Calendario de contribuciones públicas del perfil Carluve durante el último año.
          </p>
          {activity && (
            <p class="mt-4 font-heading text-2xl font-medium text-heading">
              {totalLabel} contribuciones en el último año
            </p>
          )}
        </>
      )
    }

    <div
      class:list={['overflow-x-auto', compact ? 'mt-4' : 'mt-6']}
      tabindex="0"
      role="region"
      aria-label="Calendario de contribuciones, desplazable en horizontal"
    >
      {
        activity ? (
          <svg
            class="block text-muted"
            width={width}
            height={height}
            viewBox={`0 0 ${width} ${height}`}
            role="img"
            aria-label={summary}
          >
            {weeks.map(
              (week, column) =>
                week.month && (
                  <text class="gh-label" x={labelWidth + column * step} y={12}>
                    {week.month}
                  </text>
                )
            )}
            {!compact &&
              [
                { row: 1, text: 'L' },
                { row: 3, text: 'X' },
                { row: 5, text: 'V' },
              ].map(({ row, text }) => (
                <text class="gh-label" x={0} y={labelHeight + row * step + cell - 2}>
                  {text}
                </text>
              ))}
            {weeks.map((week, column) =>
              week.days.map(
                (day, row) =>
                  day && (
                    <rect
                      class={`gh-${day.level}`}
                      x={labelWidth + column * step}
                      y={labelHeight + row * step}
                      width={cell}
                      height={cell}
                      rx="2"
                    >
                      <title>{day.tip}</title>
                    </rect>
                  )
              )
            )}
          </svg>
        ) : (
          <img
            src={fallbackChart}
            alt={summary}
            width="720"
            height="112"
            loading="lazy"
            decoding="async"
            class="block h-auto w-[720px] max-w-none"
          />
        )
      }
    </div>

    {
      activity && (
        <div class:list={['flex items-center gap-2 text-xs text-muted', compact ? 'mt-3' : 'mt-4']}>
          <span>Menos</span>
          {[0, 1, 2, 3, 4].map((level) => (
            <span aria-hidden="true" class:list={['inline-block h-3 w-3 rounded-[2px]', `gh-${level}`]} />
          ))}
          <span>Más</span>
        </div>
      )
    }

    <p class:list={[compact ? 'mt-3' : 'mt-5']}>
      <a
        class="text-sm font-medium text-link hover:underline"
        href={profileUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        github.com/Carluve
      </a>
    </p>
  </div>
</Root>

<style>
  .gh-label {
    fill: var(--aw-color-text-muted);
    font-size: 11px;
    font-family: var(--aw-font-sans, ui-sans-serif), system-ui, sans-serif;
  }
  .gh-0 {
    fill: rgb(226 232 240);
    background-color: rgb(226 232 240);
  }
  .gh-1 {
    fill: rgb(191 214 252);
    background-color: rgb(191 214 252);
  }
  .gh-2 {
    fill: rgb(110 163 247);
    background-color: rgb(110 163 247);
  }
  .gh-3 {
    fill: rgb(1 97 239);
    background-color: rgb(1 97 239);
  }
  .gh-4 {
    fill: rgb(0 74 191);
    background-color: rgb(0 74 191);
  }
  :global(.dark) .gh-0 {
    fill: rgb(46 62 88);
    background-color: rgb(46 62 88);
  }
  :global(.dark) .gh-1 {
    fill: rgb(30 64 120);
    background-color: rgb(30 64 120);
  }
  :global(.dark) .gh-2 {
    fill: rgb(37 99 196);
    background-color: rgb(37 99 196);
  }
  :global(.dark) .gh-3 {
    fill: rgb(56 132 255);
    background-color: rgb(56 132 255);
  }
  :global(.dark) .gh-4 {
    fill: rgb(186 210 255);
    background-color: rgb(186 210 255);
  }
</style>
