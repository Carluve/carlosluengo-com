---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';
import LanguageSwitch from '~/components/common/LanguageSwitch.astro';
import Search from '~/components/common/Search.astro';
import { getLang, localizePath } from '~/i18n/utils';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const lang = getLang(Astro);
const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// Compare paths without trailing slashes so the active link is detected
// regardless of the `trailingSlash` setting (`getPermalink()` emits `/contact/`
// when it is enabled, while `currentPath` above never has one, see #557).
// A link is active on its own page and on pages below it; the blog link also
// covers posts, categories and tags, whatever their language.
const isActive = (href?: string) => {
  if (typeof href !== 'string') return false;
  const link = `/${trimSlash(href)}`;
  if (link === currentPath) return true;
  if (link === '/' || link === '/en') return false;
  if (/\/blog$/.test(link)) return /^(\/en)?\/(blog|category|tag)(\/|$)/.test(currentPath);
  return currentPath.startsWith(`${link}/`);
};

// The header is kept across view transitions (transition:persist) so its state
// survives client-side navigations. Astro matches persisted elements by name,
// so the name must change whenever the header content does: otherwise a page
// with its own menu (the demo homes, the landing pages) would keep showing the
// header of the page the visitor came from. Hash the props that shape the markup.
const persistKey = `header-${Array.from(
  JSON.stringify({ links, actions, isSticky, isDark, isFullWidth, showToggleTheme, showRssFeed, position })
)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<aw-header transition:persist={persistKey}>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0"></div>
    <div
      class:list={[
        'relative text-default py-2.5 px-4 sm:px-6 mx-auto w-full',
        {
          'xl:flex xl:justify-between': position !== 'center',
        },
        {
          // The menu takes its own width and the sides share the rest, so the
          // actions on the right can never run into the last menu item.
          'xl:grid xl:grid-cols-[1fr_auto_1fr] xl:items-center': position === 'center',
        },
        {
          'max-w-6xl': !isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between']}>
        <a class="flex items-center" href={localizePath(getHomePermalink(), lang)}>
          <Logo />
        </a>
        <div class="flex items-center xl:hidden">
          <Search />
          <ToggleMenu controls="header-nav" />
        </div>
      </div>
      <nav
        id="header-nav"
        class="items-center w-full xl:w-auto hidden xl:flex xl:mx-5 text-default overflow-y-auto overflow-x-hidden xl:overflow-visible xl:justify-self-center"
        aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}
      >
        <ul
          class="aw-nav-pills relative flex flex-col xl:flex-row xl:self-center w-full xl:w-auto text-lg xl:text-sm tracking-normal font-medium xl:justify-center"
        >
          <li class="aw-nav-pill hidden xl:block" aria-hidden="true"></li>
          {
            links.map(({ text, href, links }) => (
              <li class={links?.length ? 'dropdown' : ''}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="hover:text-link px-3 py-2.5 xl:py-2 flex items-center whitespace-nowrap rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      {text}{' '}
                      <Icon
                        name="tabler:chevron-down"
                        class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden xl:inline"
                      />
                    </button>
                    <ul class="dropdown-menu xl:backdrop-blur-md dark:xl:bg-slate-900 dark:xl:border dark:xl:border-slate-700/50 rounded xl:absolute pl-4 xl:pl-0 xl:hidden font-medium xl:bg-white/90 xl:min-w-[200px] drop-shadow-xl">
                      {links.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'first:rounded-t last:rounded-b xl:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2 px-5 block whitespace-nowrap',
                              { 'aw-link-active': isActive(href2) },
                            ]}
                            href={href2}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'relative hover:text-link px-3 py-2.5 xl:py-2 flex items-center whitespace-nowrap rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary',
                      { 'aw-link-active': isActive(href) },
                    ]}
                    href={href}
                    aria-current={isActive(href) ? 'page' : undefined}
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div
        class:list={[
          { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          'hidden xl:self-center xl:flex items-center xl:mb-0 fixed w-full xl:w-auto xl:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 xl:p-0 xl:justify-self-end',
        ]}
      >
        <div class="items-center flex justify-between w-full xl:w-auto">
          <div class="flex items-center gap-1">
            <span class="mr-1"><LanguageSwitch /></span>
            <span class="hidden xl:inline-flex"><Search /></span>
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 xl:w-5 xl:h-5 xl:inline-block" />}
            {
              showRssFeed && (
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={lang === 'en' ? 'RSS feed' : 'Canal RSS'}
                  href={getAsset('/rss.xml')}
                >
                  <Icon name="tabler:rss" class="w-5 h-5" />
                </a>
              )
            }
          </div>
          {
            actions?.length ? (
              <span class="ml-4 rtl:ml-0 rtl:mr-4">
                {actions.map((btnProps) => (
                  <Button {...btnProps} class="ml-2 py-2.5 px-5.5 xl:px-6 font-semibold shadow-none text-sm w-auto" />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>
      </div>
    </div>
  </header>
  <Search variant="dialog" />
</aw-header>

<style>
  aw-header {
    display: contents;
  }
  /* Hover pill that glides between menu items (EasyUI Pill Navigation, MIT). */
  .aw-nav-pill {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2.25rem;
    width: var(--pill-w, 0);
    translate: var(--pill-x, 0) -50%;
    border-radius: 999px;
    background: color-mix(in oklab, var(--aw-color-primary) 9%, transparent);
    opacity: 0;
    pointer-events: none;
    transition:
      translate 280ms cubic-bezier(0.22, 1, 0.36, 1),
      width 280ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 160ms ease-out;
  }
  .aw-nav-pills[data-pill] .aw-nav-pill {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .aw-nav-pill {
      transition: opacity 160ms ease-out;
    }
  }
</style>

<script>
  // Move the hover pill under the pointer's menu item (desktop only).
  document.addEventListener('pointerover', (event) => {
    if (!matchMedia('(min-width: 1280px)').matches) return;
    const list = document.querySelector<HTMLElement>('.aw-nav-pills');
    if (!list) return;
    const link = (event.target as Element | null)?.closest?.<HTMLElement>('.aw-nav-pills > li > a');
    if (!link || !list.contains(link)) {
      delete list.dataset.pill;
      return;
    }
    const box = list.getBoundingClientRect();
    const r = link.getBoundingClientRect();
    list.style.setProperty('--pill-x', `${r.left - box.left}px`);
    list.style.setProperty('--pill-w', `${r.width}px`);
    list.dataset.pill = '';
  });
</script>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onKeydown?: (e: KeyboardEvent) => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('#header nav');
      const lastChild = this.querySelector<HTMLElement>('#header > div > div:last-child');

      // The header persists across view transitions (transition:persist), so
      // the server-rendered `aw-link-active` class would go stale. Re-compute it
      // on every navigation (astro:page-load fires on load and after each swap).
      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', document.documentElement.lang === 'en' ? 'Open menu' : 'Abrir el menú');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded', 'bg-page');
        nav?.classList.add('hidden');
        lastChild?.classList.add('hidden');
      };

      // Mobile menu toggle.
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        const en = document.documentElement.lang === 'en';
        toggle.setAttribute(
          'aria-label',
          expanded ? (en ? 'Close menu' : 'Cerrar el menú') : en ? 'Open menu' : 'Abrir el menú'
        );
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.classList.toggle('hidden');
        lastChild?.classList.toggle('hidden');
      });

      // Close the mobile menu when a nav link is clicked.
      nav?.addEventListener('click', closeMenu);

      // Escape closes the open mobile menu and hands focus back to the toggle.
      this.onKeydown = (e: KeyboardEvent) => {
        if (e.key !== 'Escape' || !toggle?.classList.contains('expanded')) return;
        closeMenu();
        toggle.focus();
      };
      document.addEventListener('keydown', this.onKeydown);

      // Desktop dropdowns open on hover/`:focus-within`. When a dropdown link is
      // clicked it keeps focus, and because the header uses `transition:persist`
      // the dropdown would stay open after the client-side navigation. Blur the
      // link on click so it closes right away (the `astro:page-load` handler is
      // the safety net if focus is restored during the swap).
      nav?.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest<HTMLElement>('.dropdown-menu a');
        if (link) link.blur();
      });

      // Close it when leaving the mobile/tablet breakpoint (desktop nav starts at `lg`).
      this.mql = window.matchMedia('(max-width: 1279px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      // Sticky header: toggle the `scroll` class past a small threshold.
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
      if (this.onKeydown) document.removeEventListener('keydown', this.onKeydown);
    }

    // With `transition:persist` the header (and its focus) survives client-side
    // navigations, so a clicked dropdown link keeps `:focus-within` and its menu
    // would stay open on the next page. Drop the focus so the CSS closes it.
    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        const url = new URL(a.href, window.location.href);
        // Anchor-only links (`#`, `/#features`) resolve to the current page and
        // would light up everywhere; only path links can be "the current page".
        const isPathLink =
          url.origin === window.location.origin && !url.hash && !a.getAttribute('href')?.startsWith('#');
        const link = norm(url.pathname);
        const below =
          link !== '/' &&
          link !== '/en' &&
          (/\/blog$/.test(link) ? /^(\/en)?\/(blog|category|tag)(\/|$)/.test(current) : current.startsWith(`${link}/`));
        a.classList.toggle('aw-link-active', isPathLink && (link === current || below));
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
