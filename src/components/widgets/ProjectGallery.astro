---
/**
 * Project gallery for /developer, fed by src/data/projects.ts.
 * Featured projects get wide cards; the rest sit in a three-column grid.
 * Each card's id is the project slug, the anchor that old blog URLs redirect to.
 */
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import { projects, type Project } from '~/data/projects';
import { resolveMediaUrl } from '~/utils/media';

export interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
}

const { id = 'proyectos', title = 'Proyectos', subtitle } = Astro.props;

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured).sort((a, b) => (b.year ?? 0) - (a.year ?? 0));

const links = (p: Project) =>
  [
    p.demo && { href: p.demo, text: 'Demo', icon: 'tabler:external-link', external: true },
    p.repo && { href: p.repo, text: 'Código', icon: 'tabler:brand-github', external: true },
    p.post && { href: p.post, text: 'Artículo', icon: 'tabler:article', external: false },
    p.pdf && { href: resolveMediaUrl(p.pdf), text: 'Material (PDF)', icon: 'tabler:file-type-pdf', external: true },
  ].filter(Boolean) as Array<{ href: string; text: string; icon: string; external: boolean }>;
---

<section id={id} class="scroll-mt-24">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-16">
    <p class="aw-eyebrow">Demos y código</p>
    <h2 class="mt-2 font-heading text-3xl font-medium tracking-tight text-heading md:text-4xl">{title}</h2>
    {subtitle && <p class="mt-3 max-w-2xl leading-relaxed text-muted">{subtitle}</p>}

    {
      [featured, rest].map((group, gi) => (
        <ul class:list={['mt-8 grid gap-5', gi === 0 ? 'md:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-3']}>
          {group.map((p) => (
            <li id={p.slug} class="scroll-mt-24">
              <article class="aw-card aw-spotlight aw-reveal group flex h-full flex-col overflow-hidden">
                {p.image ? (
                  <div class="overflow-hidden border-b border-line bg-primary/5">
                    <Image
                      src={p.image}
                      alt=""
                      class="aspect-[16/10] w-full object-cover object-top motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.03]"
                      widths={[400, 800]}
                      width={800}
                      height={500}
                      sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : (
                  <div
                    class="aw-cover flex aspect-[16/10] items-center justify-center border-b border-line"
                    style="--cover-x1:20%;--cover-y1:20%;--cover-x2:80%;--cover-y2:90%;--cover-hue:216"
                  >
                    <span class="font-heading text-3xl font-medium tracking-tight text-primary/70 dark:text-sky-200/80">
                      {p.title}
                    </span>
                  </div>
                )}
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-baseline justify-between gap-3">
                    <h3 class="font-heading text-xl font-medium leading-snug text-heading">{p.title}</h3>
                    {p.year && <span class="text-xs tabular-nums text-muted">{p.year}</span>}
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>
                  <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tecnologías">
                    {p.tags.map((tag) => (
                      <li class="rounded-full border border-line px-2 py-0.5 text-xs text-muted">{tag}</li>
                    ))}
                  </ul>
                  {p.basedOn && (
                    <p class="mt-3 text-xs text-muted">
                      Basado en{' '}
                      <a
                        class="underline decoration-line underline-offset-2 hover:text-link"
                        href={p.basedOn.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {p.basedOn.name}
                      </a>
                    </p>
                  )}
                  <div class="mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-4">
                    {links(p).map((l) => (
                      <a
                        class="inline-flex items-center gap-1 text-sm font-medium text-link hover:underline"
                        href={l.href}
                        {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      >
                        <Icon name={l.icon} class="h-4 w-4" />
                        {l.text}
                        {l.external && <span class="sr-only">(se abre en otra pestaña)</span>}
                      </a>
                    ))}
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>
