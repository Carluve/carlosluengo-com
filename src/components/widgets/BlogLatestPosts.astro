---
import { getLang, localizePath, useTranslations } from '~/i18n/utils';
import { APP_BLOG } from 'astrowind:config';

import Grid from '~/components/blog/Grid.astro';

import { getBlogPermalink } from '~/utils/permalinks';
import { fetchPosts } from '~/utils/blog';
import { serieDePost } from '~/data/series';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';
import Button from '~/components/ui/Button.astro';

export interface Props extends Widget {
  title?: string;
  linkText?: string;
  linkUrl?: string | URL;
  information?: string;
  count?: number;
  /** Omit posts whose category slug matches, so the home page can feature essays. */
  excludeCategory?: string;
  /** At most this many Serie Cloudflare parts, so the series does not fill the grid. */
  maxSerie?: number;
}

const {
  title = await Astro.slots.render('title'),
  linkText,
  linkUrl = getBlogPermalink(),
  information = await Astro.slots.render('information'),
  count = 4,
  excludeCategory,
  maxSerie = 1,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
const lang = getLang(Astro);
const t = useTranslations(lang);

// At most `maxSerie` parts of each series, so one series doesn't fill the block.
const serieShown = new Map<string, number>();
const keep = (post: { tags?: Array<{ slug: string }> }) => {
  const s = serieDePost(post);
  if (!s) return true;
  const n = serieShown.get(s.id) ?? 0;
  serieShown.set(s.id, n + 1);
  return n < maxSerie;
};
const posts = APP_BLOG.isEnabled
  ? (await fetchPosts())
      .filter((post) => !excludeCategory || post.category?.slug !== excludeCategory)
      .filter(keep)
      .slice(0, count)
  : [];
---

{
  APP_BLOG.isEnabled ? (
    <WidgetWrapper id={id} isDark={isDark} containerClass={classes?.container as string} bg={bg}>
      <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          {title && (
            <h2 class="font-heading text-3xl font-medium tracking-tight text-heading md:text-4xl" set:html={title} />
          )}
          {information && <p class="mt-3 leading-relaxed text-muted" set:html={information} />}
        </div>
        {APP_BLOG.list.isEnabled && linkUrl && (
          <Button
            variant="tertiary"
            href={localizePath(String(linkUrl), lang)}
            icon="tabler:arrow-right"
            class="shrink-0"
          >
            {linkText ?? t('blog.seeBlog')}
          </Button>
        )}
      </div>

      <Grid posts={posts} />
    </WidgetWrapper>
  ) : (
    <Fragment />
  )
}
