---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { getColumnsClass } from '~/utils/utils';
import type { Features as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 3,
  defaultIcon,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const columnsClass = getColumnsClass(columns);

const cardClass =
  'aw-card relative flex flex-col p-6 motion-safe:transition motion-safe:duration-200 motion-reduce:transition-none';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={classes?.container as string} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />
  <slot name="after-headline" />

  {
    items.length > 0 && (
      <div class:list={['grid gap-4 md:gap-6 gap-x-12', columnsClass]}>
        {items.map(({ title: itemTitle, description, icon, callToAction, actions, eyebrow, href }) => {
          const actionList = actions?.length ? actions : !href && callToAction ? [callToAction] : [];
          // A single `href` makes the whole card a link. Several actions stay
          // separate links, so the card itself is not clickable.
          const cardHref = actionList.length > 0 ? undefined : href;
          const Card = cardHref ? 'a' : 'div';
          const external = typeof cardHref === 'string' && /^https?:\/\//.test(cardHref);
          return (
            <Card
              href={cardHref}
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class:list={[
                cardClass,
                'h-full',
                cardHref &&
                  'hover:border-primary/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 motion-safe:hover:-translate-y-px',
              ]}
            >
              {(icon || defaultIcon) && (
                <div class="mb-5 grid h-10 w-10 place-items-center rounded-lg bg-primary/10 text-primary">
                  <Icon name={icon || defaultIcon} class="h-5 w-5" />
                </div>
              )}
              {eyebrow && <p class="aw-eyebrow mb-3">{eyebrow}</p>}
              <h3 class="font-heading text-xl font-medium leading-snug text-pretty text-heading">{itemTitle}</h3>
              {description && <div class="text-muted mt-2" set:html={description} />}
              {actionList.length > 0 && (
                <div class="mt-auto flex flex-wrap gap-3 pt-5">
                  {actionList.map((action) => (
                    <Button {...action} />
                  ))}
                </div>
              )}
            </Card>
          );
        })}
      </div>
    )
  }
</WidgetWrapper>
