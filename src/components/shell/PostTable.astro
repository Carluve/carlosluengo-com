---
import { Icon } from 'astro-icon/components';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { isMediaRef, resolveMediaUrl } from '~/utils/media';
import { getFormattedDate } from '~/utils/utils';
import { postGroup, postGroupOrder, type PostGroupId } from '~/utils/post-groups';
import type { Post } from '~/types';

interface Props {
  posts: Post[];
  heading?: string;
  /** Static preview: no client filter or pagination. */
  interactive?: boolean;
  archiveHref?: string;
}

const { posts, heading = 'Artículos', interactive = true, archiveHref = getBlogPermalink() } = Astro.props;

const rows = posts.map((post) => {
  const group = postGroup(post.category);
  const image = post.image;
  const src = !image
    ? undefined
    : typeof image === 'string'
      ? isMediaRef(image)
        ? resolveMediaUrl(image)
        : image
      : image.src;
  const year = post.publishDate.getUTCFullYear();
  const permalink = getPermalink(post.permalink, 'post');
  return {
    post,
    group,
    src,
    year,
    permalink,
    tipo: post.category?.slug === 'proyectos' ? 'Proyecto' : 'Ensayo',
    search: [post.title, post.slug, post.excerpt, post.category?.title, ...(post.tags || []).map((tag) => tag.title)]
      .filter(Boolean)
      .join(' '),
  };
});

const years: number[] = [];
for (const row of rows) if (!years.includes(row.year)) years.push(row.year);

const grouped: Array<{ year: number; rows: typeof rows }> = [];
for (const row of rows) {
  const last = grouped[grouped.length - 1];
  if (!last || last.year !== row.year) grouped.push({ year: row.year, rows: [row] });
  else last.rows.push(row);
}

const present = new Set(rows.map((row) => row.group.id));
const tabs: Array<{ id: PostGroupId | 'all'; label: string; count: number }> = [
  { id: 'all', label: 'Todos', count: rows.length },
  ...postGroupOrder
    .filter((id) => present.has(id))
    .map((id) => ({
      id,
      label: rows.find((row) => row.group.id === id)?.group.label || id,
      count: rows.filter((row) => row.group.id === id).length,
    })),
];

const pageSize = 10;
const shown = Math.min(pageSize, rows.length);
const Root = interactive ? 'aw-data-table' : 'div';
---

<Root class="dash-card" data-page-size={interactive ? String(pageSize) : undefined}>
  <div class="dash-card-head">
    <div class="dash-card-title">
      <h2>{heading}</h2>
      <span class="count-badge" data-total>{rows.length}</span>
    </div>
    {
      interactive ? (
        <div class="dash-card-tools">
          <label class="dash-search dash-search-compact">
            <span class="sr-only">Buscar en la tabla</span>
            <Icon name="tabler:search" class="h-4 w-4" aria-hidden="true" />
            <input data-query type="search" placeholder="Buscar" autocomplete="off" />
          </label>
          <details class="dash-pop" data-year-filter>
            <summary>
              <Icon name="tabler:filter" class="h-4 w-4" aria-hidden="true" />
              Filtro
            </summary>
            <fieldset>
              <legend>Año</legend>
              {years.map((year) => (
                <label>
                  <input type="checkbox" value={String(year)} data-year-option checked />
                  {year}
                </label>
              ))}
            </fieldset>
          </details>
          <details class="dash-pop">
            <summary>
              <Icon name="tabler:columns-3" class="h-4 w-4" aria-hidden="true" />
              Columnas
            </summary>
            <fieldset>
              <legend>Columnas visibles</legend>
              <label>
                <input type="checkbox" data-column="categoria" checked /> Categoría
              </label>
              <label>
                <input type="checkbox" data-column="tipo" checked /> Tipo
              </label>
              <label>
                <input type="checkbox" data-column="lectura" checked /> Lectura
              </label>
              <label>
                <input type="checkbox" data-column="fecha" checked /> Fecha
              </label>
            </fieldset>
          </details>
        </div>
      ) : (
        <a class="dash-btn" href={archiveHref}>
          Ver todos
        </a>
      )
    }
  </div>

  {
    interactive && (
      <div class="dash-tabs" role="group" aria-label="Categorías">
        {tabs.map((tab) => (
          <button type="button" data-group={tab.id} aria-pressed={tab.id === 'all' ? 'true' : 'false'}>
            {tab.label}
            <span data-group-count={tab.id}>{tab.count}</span>
          </button>
        ))}
      </div>
    )
  }

  <div class="table-scroll" tabindex="0" role="region" aria-label="Tabla de artículos, desplazable en horizontal">
    <table>
      <caption class="sr-only">{heading}</caption>
      <thead>
        <tr>
          <th scope="col">Artículo</th>
          <th scope="col" data-col="categoria">Categoría</th>
          <th scope="col" data-col="tipo">Tipo</th>
          <th scope="col" data-col="lectura">Lectura</th>
          <th scope="col" data-col="fecha">Fecha</th>
          <th scope="col"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody>
        {
          grouped.map((group) => (
            <>
              <tr data-year-header={group.year}>
                <th scope="rowgroup" colspan="6">
                  <span>{group.year}</span>
                  <span class="count-badge" data-year-count>
                    {group.rows.length}
                  </span>
                </th>
              </tr>
              {group.rows.map((row) => (
                <tr
                  data-row
                  data-year={row.year}
                  data-group={row.group.id}
                  data-cover={row.src ? '1' : '0'}
                  data-search={row.search}
                >
                  <td>
                    <a class="record" href={row.permalink}>
                      <span class="thumb" aria-hidden="true">
                        {row.src ? (
                          <img
                            src={row.src}
                            alt=""
                            width="40"
                            height="40"
                            loading="lazy"
                            decoding="async"
                            data-thumb
                          />
                        ) : (
                          <span>CL</span>
                        )}
                      </span>
                      <span class="min-w-0">
                        <span class="record-title">{row.post.title}</span>
                        <span class="record-meta">{row.post.slug}</span>
                      </span>
                    </a>
                  </td>
                  <td data-col="categoria">
                    <span class:list={['status', `tone-${row.group.tone}`]}>
                      <span class="status-dot" aria-hidden="true" />
                      {row.post.category?.title || 'Sin categoría'}
                    </span>
                  </td>
                  <td data-col="tipo">{row.tipo}</td>
                  <td data-col="lectura">{row.post.readingTime ? `${row.post.readingTime} min` : '—'}</td>
                  <td data-col="fecha">
                    <time datetime={row.post.publishDate.toISOString()}>{getFormattedDate(row.post.publishDate)}</time>
                  </td>
                  <td>
                    <details class="row-menu">
                      <summary aria-label={`Acciones de ${row.post.title}`}>
                        <Icon name="tabler:dots" class="h-4 w-4" aria-hidden="true" />
                      </summary>
                      <div>
                        <a href={row.permalink}>Abrir</a>
                        <button type="button" data-copy={row.permalink}>
                          Copiar enlace
                        </button>
                      </div>
                    </details>
                  </td>
                </tr>
              ))}
            </>
          ))
        }
        <tr data-empty hidden>
          <td colspan="6">Ningún artículo coincide con la búsqueda.</td>
        </tr>
      </tbody>
    </table>
  </div>

  {
    interactive && (
      <div class="dash-pager">
        <p data-range>
          Mostrando {rows.length === 0 ? 0 : 1}–{shown} de {rows.length}
        </p>
        <div>
          <button type="button" data-page="prev" disabled={rows.length === 0}>
            Anterior
          </button>
          <button type="button" data-page="next" disabled={rows.length <= pageSize}>
            Siguiente
          </button>
        </div>
      </div>
    )
  }
</Root>
