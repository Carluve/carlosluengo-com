---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Projects from '~/components/widgets/Projects.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Desarrollo',
  description:
    'Repositorios públicos de Carlos Luengo Vera: el sitio personal y un índice comunitario de recursos de Cloudflare en español.',
};

const githubProfile = 'https://github.com/Carluve';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Desarrollo"
    title="Experimentación técnica"
    subtitle="Prototipos y documentación publicados cuando el repositorio es público. Esta página no presenta proyectos ficticios."
    callToAction={{
      variant: 'primary',
      text: 'Perfil en GitHub',
      href: githubProfile,
      target: '_blank',
      icon: 'tabler:brand-github',
    }}
  />

  <Projects
    id="repositorios"
    tagline="Repositorios"
    title="Código público"
    subtitle="Selección breve. El perfil de GitHub reúne el resto de repositorios públicos."
    columns={3}
    items={[
      {
        title: 'carlosluengo.com',
        description: 'Este sitio: páginas estáticas con Astro y Tailwind, publicadas en Cloudflare Pages.',
        tags: ['Astro', 'Cloudflare Pages'],
        href: 'https://github.com/Carluve/carlosluengo-com',
        linkText: 'Ver el repositorio',
      },
      {
        title: 'Cloudflare en español',
        description:
          'Índice comunitario e independiente de documentación y ejemplos de Cloudflare en español. No es un repositorio oficial de la compañía.',
        tags: ['Documentación', 'Cloudflare'],
        href: 'https://github.com/Carluve/vibe-coding-spanish',
        linkText: 'Ver el repositorio',
      },
      {
        title: 'Perfil de GitHub',
        description:
          'Conjunto de repositorios públicos bajo el usuario Carluve, incluidos experimentos que no se destacan en esta página.',
        tags: ['GitHub'],
        href: githubProfile,
        linkText: 'Abrir el perfil',
      },
    ]}
  />

  <Features
    tagline="Entorno"
    title="Herramientas de los prototipos"
    subtitle="Medios con los que se documenta la experimentación técnica y este sitio."
    columns={4}
    items={[
      { title: 'Cloudflare Workers', icon: 'tabler:cloud-code' },
      { title: 'Agentes e inteligencia artificial', icon: 'tabler:robot' },
      { title: 'MCP', icon: 'tabler:plug' },
      { title: 'Astro y Cloudflare Pages', icon: 'tabler:rocket' },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'GitHub',
        href: githubProfile,
        target: '_blank',
      },
      {
        text: 'Contacto',
        href: getPermalink('/contact'),
      },
    ]}
  >
    <Fragment slot="title">Consultas técnicas</Fragment>
    <Fragment slot="subtitle">
      Las preguntas sobre estos repositorios pueden dirigirse por LinkedIn, desde la página de contacto.
    </Fragment>
  </CallToAction>
</Layout>
