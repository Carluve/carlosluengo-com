---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ProjectGallery from '~/components/widgets/ProjectGallery.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import GithubActivity from '~/components/widgets/GithubActivity.astro';
import { getPermalink } from '~/utils/permalinks';
import { projects } from '~/data/projects';

const metadata = {
  title: 'Proyectos y desarrollo',
  description:
    'Demos y repositorios públicos de Carlos Luengo Vera: juegos y herramientas sobre Cloudflare Workers, aplicaciones educativas y experimentos con IA.',
};

const githubProfile = 'https://github.com/Carluve';
const live = projects.filter((p) => p.demo).length;
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Desarrollo"
    title="Proyectos y experimentos"
    subtitle={`Demos en producción y código abierto: juegos, herramientas educativas y prototipos sobre Cloudflare Workers. ${live} demos se pueden probar ahora mismo.`}
    callToAction={{
      variant: 'primary',
      text: 'Perfil en GitHub',
      href: githubProfile,
      target: '_blank',
      icon: 'tabler:brand-github',
    }}
  />

  <ProjectGallery title="Proyectos" />

  <GithubActivity />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Contactar',
        href: getPermalink('/contact'),
      },
      {
        text: 'GitHub',
        href: githubProfile,
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">¿Hablamos de algún proyecto?</Fragment>
    <Fragment slot="subtitle">Para colaboraciones, charlas o preguntas sobre estas demos.</Fragment>
  </CallToAction>
</Layout>
