---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Página no encontrada`;
---

<Layout metadata={{ title }} shellTitle="No encontrada" shellHeading={false}>
  <section class="panel max-w-xl">
    <p class="aw-eyebrow">Error 404</p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight text-heading">La página solicitada no está publicada.</h1>
    <p class="mt-3 text-[15px] leading-relaxed text-muted">
      La dirección no corresponde a ninguna sección de este sitio. Puede continuar desde el inicio.
    </p>
    <a class="dash-btn dash-btn-primary mt-6" href={getHomePermalink()}>Volver al inicio</a>
  </section>
</Layout>
