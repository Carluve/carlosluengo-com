---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { getBlogPermalink, getHomePermalink, getPermalink } from '~/utils/permalinks';

const title = `Página no encontrada`;

const sections = [
  { text: 'Blog', href: getBlogPermalink() },
  { text: 'Academia', href: getPermalink('/academia') },
  { text: 'Desarrollo', href: getPermalink('/developer') },
  { text: 'Contacto', href: getPermalink('/contact') },
];
---

<Layout metadata={{ title }}>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex max-w-xl flex-col items-start">
      <p class="aw-eyebrow">Error 404</p>
      <h1 class="mt-3 font-heading text-4xl font-medium tracking-tight text-heading md:text-5xl">
        La página solicitada no está publicada.
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        La dirección no corresponde a ninguna sección de este sitio. Puede continuar desde el inicio o desde una de las
        secciones.
      </p>
      <a class="btn-primary mt-8" href={getHomePermalink()}>Volver al inicio</a>
      <nav aria-label="Secciones del sitio" class="mt-8">
        <ul class="flex list-none flex-wrap gap-x-6 gap-y-3">
          {
            sections.map(({ text, href }) => (
              <li>
                <a class="btn-tertiary group" href={href}>
                  {text}
                  <Icon
                    name="tabler:arrow-right"
                    class="h-4 w-4 shrink-0 rtl:rotate-180 motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:translate-x-0.5"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Layout>
