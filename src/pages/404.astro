---
/**
 * Not-found page in the language of its URL. Cloudflare serves the nearest
 * 404.html, so /en/* gets dist/en/404.html (copied there after the build by
 * scripts/postbuild.mjs from src/pages/en/404.astro, which renders this file).
 */
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { getBlogPermalink, getHomePermalink, getPermalink } from '~/utils/permalinks';
import { getLang, localizePath, useTranslations } from '~/i18n/utils';

const lang = getLang(Astro);
const t = useTranslations(lang);
const en = lang === 'en';
const link = (path: string) => localizePath(path, lang);

const sections = [
  { text: t('nav.blog'), href: link(getBlogPermalink()) },
  { text: t('nav.academia'), href: link(getPermalink('/academia')) },
  { text: t('nav.developer'), href: link(getPermalink('/developer')) },
  { text: t('nav.contact'), href: link(getPermalink('/contact')) },
];
---

<Layout metadata={{ title: t('404.title'), robots: { index: false, follow: true } }}>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex max-w-xl flex-col items-start">
      <p class="aw-eyebrow">Error 404</p>
      <h1 class="mt-3 font-heading text-4xl font-medium tracking-tight text-heading md:text-5xl">
        {en ? 'This page doesn’t exist.' : 'Esta página no existe.'}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        {
          en
            ? 'The link may be old or mistyped. Start from the home page or one of the sections below.'
            : 'Puede que el enlace sea antiguo o tenga una errata. Sigue desde el inicio o desde una de estas secciones.'
        }
      </p>
      <a class="btn-primary mt-8" href={link(getHomePermalink())}>{en ? 'Back to home' : 'Volver al inicio'}</a>
      <nav aria-label={en ? 'Site sections' : 'Secciones del sitio'} class="mt-8">
        <ul class="flex list-none flex-wrap gap-x-6 gap-y-3">
          {
            sections.map(({ text, href }) => (
              <li>
                <a class="btn-tertiary group" href={href}>
                  {text}
                  <Icon
                    name="tabler:arrow-right"
                    class="h-4 w-4 shrink-0 rtl:rotate-180 motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:translate-x-0.5"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Layout>
