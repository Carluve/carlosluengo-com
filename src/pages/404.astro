---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Página no encontrada`;
---

<Layout metadata={{ title }}>
  <section class="mx-auto flex max-w-xl flex-col items-start px-4 py-20 sm:px-6">
    <p class="aw-eyebrow">Error 404</p>
    <h1 class="mt-3 font-heading text-4xl font-medium tracking-tight text-heading md:text-5xl">
      La página solicitada no está publicada.
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      La dirección no corresponde a ninguna sección de este sitio. Puede continuar desde el inicio.
    </p>
    <a class="btn-primary mt-8" href={getHomePermalink()}>Volver al inicio</a>
  </section>
</Layout>
