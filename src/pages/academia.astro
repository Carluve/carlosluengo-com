---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Academia',
  description:
    'Publicación, docencia e investigación doctoral de Carlos Luengo Vera. Inteligencia artificial, management y evaluación de modelos de lenguaje.',
};

const scholarUrl = 'https://scholar.google.es/citations?user=ikUrqYkAAAAJ';
const paperUrl = 'https://arxiv.org/abs/2503.00025';
const paperPdfUrl = 'https://arxiv.org/pdf/2503.00025';
const paperTitle =
  'Evaluating Large Language Models on the Spanish Medical Intern Resident (MIR) Examination 2024/2025: A Comparative Analysis of Clinical Reasoning and Knowledge Application';
const paperAuthors =
  'Carlos Luengo Vera, Ignacio Ferro Picón, M. Teresa del Val Nuñez, José Andrés Gómez Gandía, Antonio de Lucas Ancillo, Víctor Ramos Arroyo y Carlos Milán Figueredo.';
const cardActionClass = 'text-sm py-2.5 px-5 md:px-6';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Academia"
    title="Investigación y docencia"
    subtitle="Doctorado en Inteligencia Artificial y Management en la Universidad de Alcalá. Docencia de posgrado y de formación ejecutiva. El listado bibliográfico completo está en Google Scholar."
    callToAction={{
      variant: 'primary',
      text: 'Google Scholar',
      href: scholarUrl,
      target: '_blank',
      icon: 'tabler:external-link',
    }}
  />

  <Features2
    id="publicaciones"
    tagline="Publicaciones"
    title="Trabajo disponible"
    subtitle="Ocho fichas del registro de publicaciones. El enlace y el estado son los que trae cada ficha."
    columns={2}
    items={[
      {
        eyebrow: 'Preprint · 2025-03-16 · arXiv',
        title: paperTitle,
        description: `<span class="block text-page dark:text-slate-200">${paperAuthors}</span><span class="mt-2 block">Comparative analysis of 22 generative AI models in clinical reasoning and performance across the MIR 2024/2025 medical exams. DOI: 10.48550/arXiv.2503.00025.</span>`,
        icon: 'tabler:file-text',
        actions: [
          {
            variant: 'primary',
            text: 'PDF en arXiv',
            href: paperPdfUrl,
            target: '_blank',
            icon: 'tabler:file-type-pdf',
            class: cardActionClass,
          },
          {
            text: 'Resumen en arXiv',
            href: paperUrl,
            target: '_blank',
            icon: 'tabler:file-text',
            class: cardActionClass,
          },
        ],
      },
      {
        eyebrow: '2025-12-26 · Journal of Open Innovation',
        title:
          'Generative AI and the Algorithmic Workplace: A Bibliometric and Conceptual Analysis of Its Impact on Organisational Decision-Making and Work Design',
        description:
          'Carlos Luengo Vera, Alnoor Bhimani, José Andrés Gómez Gandía y Antonio de Lucas (2025). Journal of Open Innovation: Technology, Market, and Complexity, 100710. Elsevier.',
        icon: 'tabler:file-text',
      },
      {
        eyebrow: '2025-11-15 · Springer Proceedings in Business and Economics',
        title:
          'Economic Resilience and Sustainability—Vol. 1: 8th International Scientific Conference on Business and Economics (ISCBE), Tetovo, North Macedonia, May 2025',
        description:
          'Ramadani, V., Bexheti, A., Abazi-Alili, H., Theodoraki, C., Rexhepi, G. y Krasniqi, B. A. (Eds.) (2025). Springer Nature Switzerland AG. El volumen incluye el capítulo sobre el análisis coste-beneficio de modelos de lenguaje en el MIR.',
        icon: 'tabler:book',
        actions: [
          {
            text: 'Springer',
            href: 'https://link.springer.com/book/9783032042170',
            target: '_blank',
            icon: 'tabler:external-link',
            class: cardActionClass,
          },
        ],
      },
      {
        eyebrow: '2025-11-10 · International Journal of Environment, Workplace and Employment',
        title: 'Geopolitical crises and the transformation of work models: a bibliometric analysis (2000-2025)',
        description:
          'Carlos Luengo Vera, José Andrés Gómez Gandía, Antonio Javier De Lucas López y Ma. Teresa de Val Núñez (2025). Vol. 9, No. 3, pp. 270-297.',
        icon: 'tabler:file-text',
        actions: [
          {
            text: 'Inderscience',
            href: 'https://www.inderscienceonline.com/doi/abs/10.1504/IJEWE.2025.149704',
            target: '_blank',
            icon: 'tabler:external-link',
            class: cardActionClass,
          },
        ],
      },
      {
        eyebrow: '2025-09-21',
        title: 'Innovation and Circular Economy: New Findings on How Innovation Drives the Circular Economy',
        description:
          'Reseña del artículo “Innovation and Circular Economy within the Sustainable …” (Elsevier, 2025) sobre cómo la innovación sostiene las prácticas de economía circular. La ficha no incluye un enlace ni una cita bibliográfica completa.',
        icon: 'tabler:file-text',
      },
      {
        eyebrow: '2025-09-11 · JOINETECH',
        title:
          'The Synergy between Green Marketing, Innovation, and Sustainability-Enhancing Green Brand Equity and Corporate Social Responsibility',
        description:
          'José Andrés Gómez Gandía, Carlos Luengo Vera y Antonio Javier De Lucas López (2025). JOINETECH (International Journal of Economic and Technological Studies), Vol. 1, Issue 01, pp. 76-89.',
        icon: 'tabler:file-text',
        actions: [
          {
            text: 'Google Scholar',
            href: 'https://scholar.google.es/citations?view_op=view_citation&hl=en&user=ikUrqYkAAAAJ&citation_for_view=ikUrqYkAAAAJ:IjCSPb-OGe4C',
            target: '_blank',
            icon: 'tabler:external-link',
            class: cardActionClass,
          },
        ],
      },
      {
        eyebrow: '2025-05-08 · 8th ISCBE, Tetovo',
        title:
          'Optimising AI in Medical Education: Cost-Benefit Analysis of Large Language Models in the MIR Examination',
        description:
          'Carlos Luengo Vera, Antonio J. de Lucas López, Víctor Ramos Arroyo y M. Teresa de Val Núñez (2025). Comunicación en el 8th ISCBE (Tetovo, 08–09 May 2025). La ficha lo registra como manuscrito en revisión para las actas de Springer.',
        icon: 'tabler:file-text',
      },
      {
        eyebrow: '2024-11-22 · Congreso de la Felicidad, Málaga',
        title: 'Impact of Generative AI on Workplace Productivity and Employee Well-being',
        description:
          'Carlos Luengo Vera, Antonio J. de Lucas López, Arturo Orea Rocha y María Teresa del Val Núñez (2024). Comunicación en el 8th International Academic and Professional Congress on Happiness (Málaga, 21–22 Nov 2024). La ficha lo registra como manuscrito en revisión.',
        icon: 'tabler:file-text',
      },
      {
        title: 'Google Scholar',
        description:
          'Perfil público con el listado de publicaciones, citas y coautores. Es la referencia para consultar el conjunto de la producción, más allá de estas fichas.',
        icon: 'tabler:school',
        href: scholarUrl,
      },
    ]}
  />

  <Features
    id="en-preparacion"
    tagline="Trabajo en curso"
    title="Manuscritos en preparación"
    subtitle="No se anticipan títulos ni resultados que aún no tengan preprint o identificador permanente."
    columns={2}
    items={[
      {
        title: 'Tesis doctoral',
        description:
          'Inteligencia Artificial y Management, Universidad de Alcalá. Línea de trabajo sobre el impacto económico y organizativo de los modelos de lenguaje.',
        icon: 'tabler:writing',
      },
      {
        title: 'Nuevas publicaciones',
        description:
          'Lo que todavía no está en las fichas anteriores no se anticipa aquí. Google Scholar sigue siendo el listado para el conjunto de la producción.',
        icon: 'tabler:hourglass',
      },
    ]}
  />

  <Features
    id="docencia"
    tagline="Docencia"
    title="Enseñanza"
    subtitle="La docencia traslada al aula la investigación y la práctica profesional, sin inventariar aquí asignaturas concretas."
    columns={2}
    items={[
      {
        title: 'Posgrado y formación ejecutiva',
        description:
          'Clases en programas de posgrado y de formación ejecutiva, en torno a la inteligencia artificial, el management y la tecnología aplicada.',
        icon: 'tabler:chalkboard',
      },
      {
        title: 'Universidad de Alcalá',
        description:
          'Adscripción doctoral en Inteligencia Artificial y Management. La universidad es el marco institucional de la investigación.',
        icon: 'tabler:building',
      },
    ]}
  />

  <Features
    id="actividad"
    tagline="Criterios"
    title="Cómo se presenta la actividad académica"
    columns={3}
    items={[
      {
        title: 'Acceso abierto',
        description: 'Preferencia por el depósito en arXiv y por un perfil público en Google Scholar.',
        icon: 'tabler:lock-open',
      },
      {
        title: 'Prudencia bibliográfica',
        description:
          'Cada ficha conserva el enlace y el estado que trae el registro, incluida la fórmula de manuscrito en revisión.',
        icon: 'tabler:scale',
      },
      {
        title: 'Industria y universidad',
        description:
          'La práctica en la industria tecnológica informa la investigación y la docencia. No las sustituye.',
        icon: 'tabler:arrows-exchange',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Abrir Google Scholar',
        href: scholarUrl,
        target: '_blank',
      },
      {
        text: 'Contacto',
        href: getPermalink('/contact'),
      },
    ]}
  >
    <Fragment slot="title">Colaboración académica</Fragment>
    <Fragment slot="subtitle">
      Para propuestas de investigación, docencia o transferencia entre universidad e industria, utilice la página de
      contacto.
    </Fragment>
  </CallToAction>
</Layout>
