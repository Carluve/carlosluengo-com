---
import Layout from '~/layouts/PageLayout.astro';
import KpiStrip from '~/components/shell/KpiStrip.astro';
import PublicationTable from '~/components/shell/PublicationTable.astro';
import OrcidBadge from '~/components/common/OrcidBadge.astro';
import { publications, scholarUrl } from '~/data/publications';
import { yearSpan } from '~/data/site-metrics';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Academia',
  description:
    'Publicación, docencia e investigación doctoral de Carlos Luengo Vera. Inteligencia artificial, management y evaluación de modelos de lenguaje.',
};

const span = yearSpan(publications.map((item) => new Date(`${item.date}T00:00:00Z`)));
---

<Layout
  metadata={metadata}
  shellTitle="Academia"
  segments={[
    { id: 'all', label: 'Todas' },
    { id: 'review', label: 'En revisión' },
  ]}
  filterLabel={span}
>
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <p class="max-w-2xl text-sm leading-relaxed text-muted">
      Doctorado en Inteligencia Artificial y Management en la Universidad de Alcalá. Ocho fichas del registro de
      publicaciones. El enlace y el estado son los que trae cada ficha. El listado bibliográfico completo está en
      Google Scholar.
    </p>
    <div class="flex flex-col items-start gap-2">
      <OrcidBadge />
      <a class="text-sm font-semibold text-link hover:underline" href={scholarUrl}>Google Scholar</a>
    </div>
  </div>

  <KpiStrip />
  <div class="mt-4">
    <PublicationTable />
  </div>

  <div class="stack-2 mt-4">
    <section class="panel">
      <h2>Manuscritos en preparación</h2>
      <p>
        No se anticipan títulos ni resultados que aún no tengan preprint o identificador permanente. La tesis doctoral,
        en Inteligencia Artificial y Management (Universidad de Alcalá), estudia el impacto económico y organizativo de
        los modelos de lenguaje.
      </p>
    </section>
    <section class="panel">
      <h2>Docencia</h2>
      <p>
        Clases en programas de posgrado y de formación ejecutiva, en torno a la inteligencia artificial, el management y
        la tecnología aplicada. La Universidad de Alcalá es el marco institucional de la investigación. Esta página no
        inventaría asignaturas concretas.
      </p>
    </section>
  </div>

  <section class="panel mt-4">
    <h2>Cómo se presenta la actividad académica</h2>
    <div class="stack-2">
      <p>Preferencia por el depósito en arXiv y por un perfil público en Google Scholar.</p>
      <p>Cada ficha conserva el enlace y el estado que trae el registro, incluida la fórmula de manuscrito en revisión.</p>
      <p>La práctica en la industria tecnológica informa la investigación y la docencia. No las sustituye.</p>
      <p>
        Para propuestas de investigación, docencia o transferencia, la vía es
        <a class="font-semibold text-link hover:underline" href={getPermalink('/contact')}>Contacto</a>.
      </p>
    </div>
  </section>
</Layout>
