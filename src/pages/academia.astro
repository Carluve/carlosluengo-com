---
import StructuredData from '~/components/common/StructuredData.astro';
import { publications, publicationSchema, SITE_URL } from '~/data/identity';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import PublicationList from '~/components/widgets/PublicationList.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Academia',
  description:
    'Publicación, docencia e investigación doctoral de Carlos Luengo Vera. Inteligencia artificial, management y evaluación de modelos de lenguaje.',
};

const scholarUrl = 'https://scholar.google.es/citations?user=ikUrqYkAAAAJ';
---

<Layout metadata={metadata}>
  <StructuredData
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      url: `${SITE_URL}/academia`,
      inLanguage: 'es',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: publications.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: publicationSchema(p),
        })),
      },
    }}
  />
  <HeroText
    tagline="Academia"
    title="Investigación y docencia"
    subtitle="Doctorado en Inteligencia Artificial y Management en la Universidad de Alcalá, sobre el impacto económico y organizativo de los modelos de lenguaje. Docencia de posgrado y de formación ejecutiva."
    callToAction={{
      variant: 'primary',
      text: 'Ver publicaciones',
      href: '#publicaciones',
      icon: 'tabler:arrow-down',
    }}
    callToAction2={{
      text: 'Google Scholar',
      href: scholarUrl,
      target: '_blank',
      icon: 'tabler:external-link',
    }}
  />

  <PublicationList lang="es" />

  <Features
    id="docencia"
    tagline="Docencia y divulgación"
    title="En el aula y en congresos"
    columns={3}
    items={[
      {
        title: 'Tesis doctoral',
        description:
          'Inteligencia Artificial y Management en la Universidad de Alcalá, por compendio de tres artículos publicados (JOItmC 2026, IEMJ 2026 y un capítulo de Springer): cómo cambian la productividad y la organización del trabajo con los modelos de lenguaje.',
        icon: 'tabler:writing',
      },
      {
        title: 'Posgrado y formación ejecutiva',
        description:
          'Clases sobre inteligencia artificial, management y tecnología aplicada en programas de posgrado y de formación ejecutiva.',
        icon: 'tabler:chalkboard',
      },
      {
        title: 'Charlas',
        description:
          'Comunicaciones en congresos y jornadas, como el 8th ISCBE o DigEduCLM, con su crónica en el blog.',
        icon: 'tabler:presentation',
        callToAction: { text: 'Ver charlas', href: getPermalink('charlas', 'category') },
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Contactar',
        href: getPermalink('/contact'),
      },
      {
        text: 'Google Scholar',
        href: scholarUrl,
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Colaboración académica</Fragment>
    <Fragment slot="subtitle">
      Propuestas de investigación, docencia o transferencia entre la universidad y la industria.
    </Fragment>
  </CallToAction>
</Layout>
