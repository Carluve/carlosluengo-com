---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Academia',
  description:
    'Publicación, docencia e investigación doctoral de Carlos Luengo Vera. Inteligencia artificial, management y evaluación de modelos de lenguaje.',
};

const scholarUrl = 'https://scholar.google.es/citations?user=ikUrqYkAAAAJ';
const paperUrl = 'https://arxiv.org/abs/2503.00025';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Academia"
    title="Investigación y docencia"
    subtitle="Doctorado en Inteligencia Artificial y Management en la Universidad de Alcalá. Docencia de posgrado y de formación ejecutiva. El listado bibliográfico completo está en Google Scholar."
    callToAction={{
      variant: 'primary',
      text: 'Google Scholar',
      href: scholarUrl,
      target: '_blank',
      icon: 'tabler:external-link',
    }}
    callToAction2={{
      text: 'Preprint en arXiv',
      href: paperUrl,
      target: '_blank',
      icon: 'tabler:file-text',
    }}
  />

  <Features2
    id="publicaciones"
    tagline="Publicaciones"
    title="Trabajo disponible"
    subtitle="Se cita únicamente el preprint con identificador público. El resto del registro bibliográfico está en Google Scholar."
    columns={2}
    items={[
      {
        title: 'Evaluating Large Language Models on the Spanish Medical Intern Resident (MIR) Examination 2024/2025',
        description:
          'Análisis comparativo del razonamiento clínico y de la aplicación de conocimiento. Preprint, arXiv:2503.00025. Carlos Luengo Vera figura como primer autor.',
        icon: 'tabler:file-text',
        href: paperUrl,
      },
      {
        title: 'Google Scholar',
        description:
          'Perfil público con el listado de publicaciones, citas y coautores. Es la referencia para consultar el conjunto de la producción, más allá de esta página.',
        icon: 'tabler:school',
        href: scholarUrl,
      },
    ]}
  />

  <Features
    id="en-preparacion"
    tagline="Trabajo en curso"
    title="Manuscritos en preparación"
    subtitle="No se anticipan títulos ni resultados que aún no tengan preprint o identificador permanente."
    columns={2}
    items={[
      {
        title: 'Tesis doctoral',
        description:
          'Inteligencia Artificial y Management, Universidad de Alcalá. Línea de trabajo sobre el impacto económico y organizativo de los modelos de lenguaje.',
        icon: 'tabler:writing',
      },
      {
        title: 'Nuevas publicaciones',
        description:
          'Los manuscritos en preparación se incorporarán a esta página cuando exista un preprint o un DOI. Hasta entonces, Google Scholar es el listado de referencia.',
        icon: 'tabler:hourglass',
      },
    ]}
  />

  <Features
    id="docencia"
    tagline="Docencia"
    title="Enseñanza"
    subtitle="La docencia traslada al aula la investigación y la práctica profesional, sin inventariar aquí asignaturas concretas."
    columns={2}
    items={[
      {
        title: 'Posgrado y formación ejecutiva',
        description:
          'Clases en programas de posgrado y de formación ejecutiva, en torno a la inteligencia artificial, el management y la tecnología aplicada.',
        icon: 'tabler:chalkboard',
      },
      {
        title: 'Universidad de Alcalá',
        description:
          'Adscripción doctoral en Inteligencia Artificial y Management. La universidad es el marco institucional de la investigación.',
        icon: 'tabler:building',
      },
    ]}
  />

  <Features
    id="actividad"
    tagline="Criterios"
    title="Cómo se presenta la actividad académica"
    columns={3}
    items={[
      {
        title: 'Acceso abierto',
        description: 'Preferencia por el depósito en arXiv y por un perfil público en Google Scholar.',
        icon: 'tabler:lock-open',
      },
      {
        title: 'Prudencia bibliográfica',
        description: 'Esta página no lista como publicación un texto que todavía no pueda citarse.',
        icon: 'tabler:scale',
      },
      {
        title: 'Industria y universidad',
        description:
          'La práctica en la industria tecnológica informa la investigación y la docencia. No las sustituye.',
        icon: 'tabler:arrows-exchange',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Abrir Google Scholar',
        href: scholarUrl,
        target: '_blank',
      },
      {
        text: 'Contacto',
        href: getPermalink('/contact'),
      },
    ]}
  >
    <Fragment slot="title">Colaboración académica</Fragment>
    <Fragment slot="subtitle">
      Para propuestas de investigación, docencia o transferencia entre universidad e industria, utilice la página de
      contacto.
    </Fragment>
  </CallToAction>
</Layout>
