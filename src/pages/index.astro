---
import CareerLogos from '~/components/widgets/CareerLogos.astro';
import { Picture } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';
import GithubActivity from '~/components/widgets/GithubActivity.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import portrait from '~/assets/images/carlos-luengo.jpg';
import Image from '~/components/common/Image.astro';
import { projects } from '~/data/projects';

const featured = projects.filter((p) => p.featured).slice(0, 3);

const metadata = {
  title: 'Carlos Luengo — Investigación, docencia e industria',
  ignoreTitleTemplate: true,
  description:
    'Doctorando en Inteligencia Artificial y Management en la Universidad de Alcalá. Docente universitario. Sr. Enterprise Account Executive en Cloudflare (Digital Natives, Startups e ISVs).',
};

const paperUrl = 'https://arxiv.org/abs/2503.00025';
const paperPdfUrl = 'https://arxiv.org/pdf/2503.00025';
---

<Layout metadata={metadata}>
  <section class="relative not-prose">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-6 pt-10 sm:px-6 md:pt-14 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:gap-16 lg:pb-10 lg:pt-16"
    >
      <div>
        <p class="aw-eyebrow">Investigación · Docencia · Industria</p>
        <h1
          class="mt-3 font-heading text-[2.65rem] font-medium leading-[1.08] tracking-tight text-balance text-heading sm:text-5xl lg:text-[3.4rem]"
        >
          Carlos Luengo Vera
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-pretty text-muted">
          Doctorando en Inteligencia Artificial y Management en la Universidad de Alcalá. Profesor en programas de
          posgrado y ejecutivos. Sr. Enterprise Account Executive en Cloudflare, donde acompaña a empresas digitales
          nativas, startups e ISVs. Su trabajo sitúa la investigación aplicada en el cruce entre adopción de IA,
          organización empresarial e infraestructura cloud.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button variant="primary" text="Contacto" href={getPermalink('/contact')} icon="tabler:mail" />
          <Button
            text="Google Scholar"
            href="https://scholar.google.es/citations?user=ikUrqYkAAAAJ"
            target="_blank"
            icon="tabler:school"
          />
        </div>
      </div>

      <figure class="relative order-first w-36 sm:w-44 lg:order-none lg:mx-auto lg:w-full lg:max-w-none">
        <div
          class="absolute -inset-3 -z-10 rounded-[1.75rem] bg-gradient-to-br from-primary/20 via-sky-200/30 to-transparent blur-2xl dark:from-primary/25 dark:via-sky-500/10"
          aria-hidden="true"
        >
        </div>
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[360, 540, 720, 960]}
          sizes="(min-width: 1024px) 30vw, 11rem"
          alt="Retrato de Carlos Luengo Vera con americana azul marino y camisa blanca, en una oficina."
          loading="eager"
          fetchpriority="high"
          class="aspect-square w-full rounded-2xl border border-line object-cover object-[50%_30%] shadow-[0_18px_50px_rgb(15_23_42/0.14)]"
        />
      </figure>
    </div>
  </section>

  <Features
    id="ambitos"
    tagline="Ámbitos"
    title="Tres líneas de trabajo"
    subtitle="La práctica en la industria, la actividad académica y la experimentación técnica publicada."
    columns={3}
    items={[
      {
        title: 'Industria',
        description:
          'Responsable de cuentas enterprise en Cloudflare (Digital Natives, Startups e ISVs). Experiencia previa en Microsoft, Insight, Telefónica, Lenovo y AWS.',
        icon: 'tabler:building-skyscraper',
        callToAction: { text: 'Trayectoria', href: getPermalink('/about') },
      },
      {
        title: 'Academia',
        description:
          'Investigación doctoral sobre el impacto económico y organizativo de los LLMs, publicaciones y docencia universitaria de posgrado.',
        icon: 'tabler:school',
        callToAction: { text: 'Investigación y docencia', href: getPermalink('/academia') },
      },
      {
        title: 'Desarrollo',
        description:
          'Demos y prototipos sobre Cloudflare Workers: juegos, herramientas educativas y experimentos con IA, con el código abierto.',
        icon: 'tabler:code',
        callToAction: { text: 'Ver proyectos', href: getPermalink('/developer') },
      },
    ]}
  />

  <CareerLogos compact />

  <section id="publicacion" class="relative not-prose scroll-mt-[72px]">
    <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-16 lg:py-20">
      <p class="aw-eyebrow">Publicación destacada</p>
      <h2 class="mt-2 max-w-3xl font-heading text-3xl font-medium tracking-tight text-heading md:text-4xl">
        Preprint MIR 2024/2025
      </h2>
      <article class="aw-card mt-8 p-6 md:p-8">
        <p class="aw-eyebrow">Preprint · 2025 · arXiv:2503.00025</p>
        <h3 class="mt-3 max-w-4xl font-heading text-2xl font-medium leading-snug text-heading md:text-3xl">
          Evaluating Large Language Models on the Spanish Medical Intern Resident (MIR) Examination 2024/2025: A
          Comparative Analysis of Clinical Reasoning and Knowledge Application
        </h3>
        <p class="mt-4 max-w-3xl leading-relaxed text-muted">
          Comparativa de 22 modelos de IA generativa en el examen MIR 2024/2025: razonamiento clínico, preguntas con
          imagen y aplicación del conocimiento. Carlos Luengo Vera es el primer autor.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button variant="primary" text="Ver en Academia" href={getPermalink('/academia')} icon="tabler:arrow-right" />
          <Button text="PDF en arXiv" href={paperPdfUrl} target="_blank" icon="tabler:file-type-pdf" />
          <Button text="Resumen en arXiv" href={paperUrl} target="_blank" icon="tabler:file-text" />
        </div>
      </article>
    </div>
  </section>

  <BlogLatestPosts
    title="Últimas entradas del blog"
    information="Inteligencia artificial aplicada, infraestructura cloud y lo que ocurre entre la industria y la universidad."
    linkText="Ver todas las entradas"
    linkUrl={getBlogPermalink()}
    count={3}
    excludeCategory="proyectos"
  />

  <section id="desarrollo" class="relative not-prose scroll-mt-[72px]">
    <div class="mx-auto max-w-6xl px-4 py-4 sm:px-6 md:pb-8">
      <p class="aw-eyebrow">Proyectos</p>
      <h2 class="mt-2 font-heading text-3xl font-medium tracking-tight text-heading md:text-4xl">
        Demos en producción
      </h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted">
        Juegos, herramientas y prototipos desplegados en Cloudflare Workers, con el código en GitHub.
      </p>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {
          featured.map((p) => (
            <li>
              <a
                class="aw-card aw-spotlight aw-reveal group flex h-full flex-col overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                href={`${getPermalink('/developer')}#${p.slug}`}
              >
                {p.image ? (
                  <Image
                    src={p.image}
                    alt=""
                    class="aspect-[16/10] w-full border-b border-line object-cover object-top"
                    widths={[400, 800]}
                    width={800}
                    height={500}
                    sizes="(min-width: 768px) 360px, 100vw"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div
                    class="aw-cover flex aspect-[16/10] items-center justify-center border-b border-line"
                    style="--cover-x1:20%;--cover-y1:20%;--cover-x2:80%;--cover-y2:90%;--cover-hue:216"
                  >
                    <span class="font-heading text-2xl font-medium text-primary/70 dark:text-sky-200/80">
                      {p.title}
                    </span>
                  </div>
                )}
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="font-heading text-xl font-medium text-heading group-hover:text-link">{p.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{p.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <GithubActivity compact />
      <div class="mt-6">
        <Button variant="tertiary" text="Ver todos los proyectos" href={getPermalink('/developer')} />
      </div>
    </div>
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Contactar',
        href: getPermalink('/contact'),
        icon: 'tabler:send',
      },
      {
        text: 'Perfil en LinkedIn',
        href: 'https://www.linkedin.com/in/carlosluengo',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Hablemos</Fragment>
    <Fragment slot="subtitle">
      Colaboraciones académicas, charlas, docencia o proyectos con Cloudflare: escríbeme y te respondo.
    </Fragment>
  </CallToAction>
</Layout>
