---
import { Picture } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import KpiStrip from '~/components/shell/KpiStrip.astro';
import PostTable from '~/components/shell/PostTable.astro';
import GithubActivity from '~/components/widgets/GithubActivity.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import { fetchPosts } from '~/utils/blog';
import { yearSpan } from '~/data/site-metrics';
import favIconSvg from '~/assets/favicons/favicon.svg';
import skyline from '~/assets/images/hero/skyline-network.jpg';
import district from '~/assets/images/hero/district-light.jpg';

const posts = await fetchPosts();
const latest = posts.filter((post) => post.category?.slug !== 'proyectos').slice(0, 6);
const span = yearSpan(posts.map((post) => post.publishDate));

const metadata = {
  title: 'Carlos Luengo — Investigación, docencia e industria',
  ignoreTitleTemplate: true,
  description:
    'Doctorando en Inteligencia Artificial y Management en la Universidad de Alcalá. Docente universitario. Sr. Enterprise Account Executive en Cloudflare (Digital Natives, Startups e ISVs).',
};

const personId = `${SITE?.site}/#person`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': personId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: 'Carlos Luengo',
    url: SITE?.site,
    jobTitle: 'Sr. Enterprise Account Executive',
    worksFor: { '@type': 'Organization', name: 'Cloudflare' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidad de Alcalá' },
    sameAs: [
      'https://www.linkedin.com/in/carlosluengo',
      'https://x.com/carluve',
      'https://github.com/Carluve',
      'https://scholar.google.es/citations?user=ikUrqYkAAAAJ',
      'https://orcid.org/0009-0008-2591-1210',
    ],
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout
  metadata={metadata}
  shellTitle="Inicio"
  shellHeading={false}
  filterLabel={span}
  filterHref={getBlogPermalink()}
>
  <StructuredData slot="head" schema={structuredData} />

  <section class="banner">
    <div class="banner-copy">
      <p class="aw-eyebrow">Investigación · Docencia · Industria</p>
      <h1>Carlos Luengo Vera</h1>
      <p>
        Doctorando en Inteligencia Artificial y Management en la Universidad de Alcalá. Profesor en programas de
        posgrado y ejecutivos. Sr. Enterprise Account Executive en Cloudflare, donde acompaña a empresas digitales
        nativas, startups e ISVs. Su trabajo sitúa la investigación aplicada en el cruce entre adopción de IA,
        organización empresarial e infraestructura cloud.
      </p>
      <div class="banner-actions">
        <a class="dash-btn dash-btn-primary" href={getPermalink('/contact')}>Contactar</a>
        <a class="dash-btn" href={getPermalink('/academia')}>Academia</a>
        <a class="dash-btn" href="https://scholar.google.es/citations?user=ikUrqYkAAAAJ" target="_blank" rel="noopener noreferrer">
          Google Scholar
        </a>
      </div>
      <p class="banner-note">
        <a href="https://arxiv.org/abs/2503.00025">Preprint MIR 2024/2025 · arXiv:2503.00025</a>
      </p>
    </div>
    <figure class="banner-figure">
      <Picture
        src={skyline}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 46vw, 100vw"
        alt="Vista aérea de un horizonte de torres unidas por una red de líneas azules, con cielo despejado a la izquierda."
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/9] w-full object-cover object-[72%_center]"
      />
      <div class="banner-inset">
        <Picture
          src={district}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 18vw, 42vw"
          alt="Avenida entre edificios de oficinas, con estelas de luz azul sobre el pavimento."
          loading="eager"
          class="aspect-[16/10] w-full object-cover"
        />
      </div>
    </figure>
  </section>

  <div class="mt-4">
    <KpiStrip />
  </div>

  <div class="mt-4">
    <PostTable posts={latest} heading="Últimos posts" interactive={false} />
  </div>

  <section class="panel mt-4">
    <GithubActivity compact />
  </section>
</Layout>
