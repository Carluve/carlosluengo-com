---
import Layout from '~/layouts/PageLayout.astro';
import { orcidUrl, xUrl } from '~/navigation';

const metadata = {
  title: 'Contacto',
  description:
    'Contacto con Carlos Luengo Vera: LinkedIn para consultas académicas y profesionales, y los perfiles públicos de GitHub, Google Scholar y X (@carluve).',
};

const channels = [
  {
    title: 'LinkedIn',
    text: 'Canal preferente para un mensaje directo, ya sea de carácter académico, docente o profesional.',
    href: 'https://www.linkedin.com/in/carlosluengo',
  },
  {
    title: 'X',
    text: 'Perfil público @carluve.',
    href: xUrl,
  },
  {
    title: 'GitHub',
    text: 'Repositorios públicos, bajo el usuario Carluve.',
    href: 'https://github.com/Carluve',
  },
  {
    title: 'Google Scholar',
    text: 'Publicaciones, citas y coautores.',
    href: 'https://scholar.google.es/citations?user=ikUrqYkAAAAJ',
  },
  {
    title: 'ORCID',
    text: '0009-0008-2591-1210',
    href: orcidUrl,
  },
];
---

<Layout metadata={metadata} shellTitle="Contacto">
  <section class="panel">
    <p class="max-w-2xl leading-relaxed text-muted">
      Las consultas académicas, las colaboraciones docentes y los asuntos profesionales se atienden por LinkedIn. Este
      sitio no publica un correo electrónico. No sustituye a los canales institucionales de Cloudflare ni a los de la
      Universidad de Alcalá.
    </p>
  </section>

  <section class="panel mt-4" aria-labelledby="vias">
    <h2 id="vias">Vías de contacto</h2>
    <div class="channel-list mt-3">
      {
        channels.map((channel) => (
          <a href={channel.href} target="_blank" rel="noopener noreferrer">
            <span>
              <strong>{channel.title}</strong>
              <span>{channel.text}</span>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <div class="stack-2 mt-4">
    <section class="panel">
      <h2>Universidad</h2>
      <p>Investigación doctoral, docencia de posgrado y posibles colaboraciones académicas.</p>
    </section>
    <section class="panel">
      <h2>Industria</h2>
      <p>
        Asuntos profesionales relacionados con Cloudflare, en el ámbito de empresas digitales nativas, startups e ISVs.
      </p>
    </section>
    <section class="panel">
      <h2>Código</h2>
      <p>Preguntas sobre los repositorios públicos enlazados en la sección de desarrollo.</p>
    </section>
  </div>
</Layout>
