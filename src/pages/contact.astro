---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { xUrl } from '~/navigation';

const metadata = {
  title: 'Contacto',
  description:
    'Contacto con Carlos Luengo Vera para colaboraciones académicas, charlas, docencia y proyectos con Cloudflare: LinkedIn, X, GitHub y Google Scholar.',
};

const linkedIn = 'https://www.linkedin.com/in/carlosluengo';
const github = 'https://github.com/Carluve';
const scholar = 'https://scholar.google.es/citations?user=ikUrqYkAAAAJ';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contacto"
    title="Hablemos"
    subtitle="Colaboraciones académicas, charlas, docencia o proyectos con Cloudflare. El mensaje directo por LinkedIn es la forma más rápida de llegar a mí."
    callToAction={{
      variant: 'primary',
      text: 'Escribir por LinkedIn',
      href: linkedIn,
      target: '_blank',
      icon: 'tabler:brand-linkedin',
    }}
  />

  <Features2
    title="Dónde encontrarme"
    columns={2}
    items={[
      {
        title: 'LinkedIn',
        description: 'Mensajes directos sobre universidad, docencia o asuntos profesionales.',
        icon: 'tabler:brand-linkedin',
        callToAction: { text: 'Enviar un mensaje', href: linkedIn, target: '_blank' },
      },
      {
        title: 'X',
        description: 'Notas cortas sobre IA, Cloudflare y lo que estoy probando. @carluve.',
        icon: 'tabler:brand-x',
        callToAction: { text: 'Seguir en X', href: xUrl, target: '_blank' },
      },
      {
        title: 'GitHub',
        description: 'El código de las demos y los proyectos de la sección de desarrollo.',
        icon: 'tabler:brand-github',
        callToAction: { text: 'Ver repositorios', href: github, target: '_blank' },
      },
      {
        title: 'Google Scholar',
        description: 'Publicaciones, citas y coautores.',
        icon: 'tabler:school',
        callToAction: { text: 'Ver publicaciones', href: scholar, target: '_blank' },
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Escribir por LinkedIn',
        href: linkedIn,
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  >
    <Fragment slot="title">¿Una charla o una colaboración?</Fragment>
    <Fragment slot="subtitle">Cuéntame el contexto y la fecha, y te respondo.</Fragment>
  </CallToAction>
</Layout>
