---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { xUrl } from '~/navigation';

const metadata = {
  title: 'Contacto',
  description:
    'Contacto con Carlos Luengo Vera: LinkedIn para consultas académicas y profesionales, y los perfiles públicos de GitHub, Google Scholar y X (@carluve).',
};

const linkedIn = 'https://www.linkedin.com/in/carlosluengo';
const github = 'https://github.com/Carluve';
const scholar = 'https://scholar.google.es/citations?user=ikUrqYkAAAAJ';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contacto"
    title="Correspondencia"
    subtitle="Las consultas académicas, las colaboraciones docentes y los asuntos profesionales se atienden por LinkedIn."
  />

  <Features2
    title="Vías de contacto"
    subtitle="LinkedIn es el canal principal. GitHub, Google Scholar y X (@carluve) son perfiles públicos."
    columns={2}
    items={[
      {
        title: 'LinkedIn',
        description: 'Canal preferente para un mensaje directo, ya sea de carácter académico, docente o profesional.',
        icon: 'tabler:brand-linkedin',
        href: linkedIn,
      },
      {
        title: 'X',
        description: 'Perfil público @carluve.',
        icon: 'tabler:brand-x',
        href: xUrl,
      },
      {
        title: 'GitHub',
        description: 'Repositorios públicos, bajo el usuario Carluve.',
        icon: 'tabler:brand-github',
        href: github,
      },
      {
        title: 'Google Scholar',
        description: 'Publicaciones, citas y coautores.',
        icon: 'tabler:school',
        href: scholar,
      },
    ]}
  />

  <Content
    items={[
      {
        title: 'Universidad',
        description: 'Investigación doctoral, docencia de posgrado y posibles colaboraciones académicas.',
      },
      {
        title: 'Industria',
        description:
          'Asuntos profesionales relacionados con Cloudflare, en el ámbito de empresas digitales nativas, startups e ISVs.',
      },
      {
        title: 'Código',
        description: 'Preguntas sobre los repositorios públicos enlazados en la sección de desarrollo.',
      },
    ]}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Ámbito de las consultas</h2>
      <p>
        Este sitio presenta una trayectoria personal. No sustituye a los canales institucionales de Cloudflare ni a los
        de la Universidad de Alcalá.
      </p>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Escribir por LinkedIn',
        href: linkedIn,
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
      {
        text: 'X',
        href: xUrl,
        target: '_blank',
        icon: 'tabler:brand-x',
      },
    ]}
  >
    <Fragment slot="title">LinkedIn</Fragment>
    <Fragment slot="subtitle">
      Es la vía adecuada para una respuesta directa. El perfil público en X es @carluve.
    </Fragment>
  </CallToAction>
</Layout>
