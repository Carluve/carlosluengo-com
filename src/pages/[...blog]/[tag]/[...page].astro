---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogTagRobots, fetchPosts, getStaticPathsBlogTag } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import PostTable from '~/components/shell/PostTable.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import { yearSpan } from '~/data/site-metrics';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogTag({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, tag } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const posts = (await fetchPosts()).filter((post) => post.tags?.some((item) => item.slug === tag.slug));
const span = yearSpan(posts.map((post) => post.publishDate));

const breadcrumbs = [
  { text: 'Inicio', href: getPermalink('/') },
  { text: 'Blog', href: getBlogPermalink() },
  ...(currentPage > 1
    ? [{ text: tag.title, href: getPermalink(tag.slug, 'tag') }, { text: `Página ${currentPage}` }]
    : [{ text: tag.title }]),
];

const metadata = {
  title: `${tag.title}${currentPage > 1 ? ` — Página ${currentPage}` : ''}`,
  description: `Textos etiquetados como ${tag.title}.`,
  robots: {
    index: blogTagRobots?.index,
    follow: blogTagRobots?.follow,
  },
};
---

<Layout
  metadata={metadata}
  shellTitle={tag.title}
  shellHeading={false}
  filterLabel={span}
>
  <h1 class="mb-3 text-lg font-semibold text-heading">Etiqueta: {tag.title}</h1>
  <Breadcrumbs class="mb-4" items={breadcrumbs} />
  <PostTable posts={posts} heading={tag.title} />
</Layout>
