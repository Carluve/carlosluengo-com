---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, fetchPosts, getStaticPathsBlogCategory } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import PostTable from '~/components/shell/PostTable.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import { yearSpan } from '~/data/site-metrics';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Record<string, string> };

const { page, category } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const posts = (await fetchPosts()).filter((post) => post.category?.slug === category.slug);
const span = yearSpan(posts.map((post) => post.publishDate));

const breadcrumbs = [
  { text: 'Inicio', href: getPermalink('/') },
  { text: 'Blog', href: getBlogPermalink() },
  ...(currentPage > 1
    ? [{ text: category.title, href: getPermalink(category.slug, 'category') }, { text: `Página ${currentPage}` }]
    : [{ text: category.title }]),
];

const metadata = {
  title: `${category.title}${currentPage > 1 ? ` — Página ${currentPage}` : ''}`,
  description: `Textos de la categoría ${category.title}.`,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout
  metadata={metadata}
  shellTitle={category.title}
  shellHeading={false}
  segments={[
    { id: 'all', label: 'Todos' },
    { id: 'cover', label: 'Con portada' },
  ]}
  filterLabel={span}
>
  <h1 class="mb-3 text-lg font-semibold text-heading">{category.title}</h1>
  <Breadcrumbs class="mb-4" items={breadcrumbs} />
  <PostTable posts={posts} heading={category.title} />
</Layout>
