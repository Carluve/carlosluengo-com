---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import KpiStrip from '~/components/shell/KpiStrip.astro';
import PostTable from '~/components/shell/PostTable.astro';
import { blogListRobots, fetchPosts, getStaticPathsBlogList } from '~/utils/blog';
import { yearSpan } from '~/data/site-metrics';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const posts = await fetchPosts();
const span = yearSpan(posts.map((post) => post.publishDate));

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Página ${currentPage}` : ''}`,
  description:
    'Notas en español sobre infraestructura cloud, inteligencia artificial aplicada y la relación entre industria y universidad.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout
  metadata={metadata}
  shellTitle="Blog"
  segments={[
    { id: 'all', label: 'Todos' },
    { id: 'cover', label: 'Con portada' },
  ]}
  filterLabel={span}
>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <KpiStrip />
  <div class="mt-4">
    <PostTable posts={posts} />
  </div>
</Layout>
