---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import SerieIndex from '~/components/blog/SerieIndex.astro';
import { SITE_URL } from '~/data/identity';
import { serieProducto } from '~/data/serie-producto';
import { publicadas } from '~/data/series';
import { getPermalink } from '~/utils/permalinks';

const seriePublicadas = publicadas(serieProducto);

const metadata = {
  title: 'Serie Producto',
  description: `${serieProducto.text.en.meta} ${seriePublicadas.length} published so far.`,
};

const breadcrumbs = [
  { text: 'Home', href: getPermalink('/en') },
  { text: 'Blog', href: getPermalink('/en/blog') },
  { text: 'Serie Producto' },
];
---

<Layout metadata={metadata}>
  <StructuredData
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      url: `${SITE_URL}/en/serie-producto`,
      inLanguage: 'en',
      name: 'Serie Producto',
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: seriePublicadas.length,
        itemListElement: seriePublicadas.map((p) => ({
          '@type': 'ListItem',
          position: p.part,
          url: `${SITE_URL}/blog/${p.slug}`,
          name: p.title,
        })),
      },
    }}
  />
  <Breadcrumbs bar items={breadcrumbs} />
  <SerieIndex lang="en" serie={serieProducto} />
</Layout>
