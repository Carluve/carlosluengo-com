---
import StructuredData from '~/components/common/StructuredData.astro';
import { publications, publicationSchema, SITE_URL } from '~/data/identity';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import PublicationList from '~/components/widgets/PublicationList.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Research',
  description:
    'Publications, teaching and doctoral research by Carlos Luengo Vera. Artificial intelligence, management and the evaluation of language models.',
};

const scholarUrl = 'https://scholar.google.es/citations?user=ikUrqYkAAAAJ';
---

<Layout metadata={metadata}>
  <StructuredData
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      url: `${SITE_URL}/en/academia`,
      inLanguage: 'en',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: publications.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: publicationSchema(p),
        })),
      },
    }}
  />
  <HeroText
    tagline="Research"
    title="Research and teaching"
    subtitle="PhD in Artificial Intelligence and Management at Universidad de Alcalá, on the economic and organisational impact of language models. Postgraduate and executive education teaching."
    callToAction={{
      variant: 'primary',
      text: 'See publications',
      href: '#publicaciones',
      icon: 'tabler:arrow-down',
    }}
    callToAction2={{
      text: 'Google Scholar',
      href: scholarUrl,
      target: '_blank',
      icon: 'tabler:external-link',
    }}
  />

  <PublicationList lang="en" />

  <Features
    id="docencia"
    tagline="Teaching and outreach"
    title="In the classroom and at conferences"
    columns={3}
    items={[
      {
        title: 'Doctoral thesis',
        description:
          'Artificial Intelligence and Management at Universidad de Alcalá, by compendium of three published papers (JOItmC 2026, IEMJ 2026 and a Springer chapter): how productivity and the organisation of work change with language models.',
        icon: 'tabler:writing',
      },
      {
        title: 'Postgraduate and executive education',
        description:
          'Classes on artificial intelligence, management and applied technology in postgraduate and executive education programmes.',
        icon: 'tabler:chalkboard',
      },
      {
        title: 'Talks',
        description:
          'Papers at conferences and events such as the 8th ISCBE and DigEduCLM, each written up on the blog.',
        icon: 'tabler:presentation',
        callToAction: { text: 'See talks', href: getPermalink('/en/category/charlas') },
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get in touch',
        href: getPermalink('/en/contact'),
      },
      {
        text: 'Google Scholar',
        href: scholarUrl,
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Academic collaboration</Fragment>
    <Fragment slot="subtitle">Proposals for research, teaching or transfer between university and industry.</Fragment>
  </CallToAction>
</Layout>
