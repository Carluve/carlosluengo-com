---
import StructuredData from '~/components/common/StructuredData.astro';
import { PERSON_ID, SITE_URL } from '~/data/identity';
import CareerTimeline from '~/components/widgets/CareerTimeline.astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import OrcidBadge from '~/components/common/OrcidBadge.astro';
import { xUrl } from '~/navigation';
import { getPermalink } from '~/utils/permalinks';
import portrait from '~/assets/images/carlos-luengo.jpg';

const metadata = {
  title: 'About',
  description:
    'Professional and academic background of Carlos Luengo Vera: enterprise account leadership at Cloudflare, a PhD in Artificial Intelligence and Management at Universidad de Alcalá, and postgraduate teaching.',
};
---

<Layout metadata={metadata}>
  <StructuredData
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: `${SITE_URL}/en/about`,
      inLanguage: 'en',
      mainEntity: { '@id': PERSON_ID },
    }}
  />
  <HeroText
    tagline="About"
    title="Professional and academic background"
    subtitle="Carlos Luengo Vera works in the technology industry and, alongside it, in university research and teaching."
  >
    <div slot="content" class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <OrcidBadge />
      <a
        class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-3 py-2 text-sm font-medium text-heading transition duration-150 ease-in-out hover:border-primary/40 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        href={xUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="tabler:brand-x" class="h-5 w-5 shrink-0" aria-hidden="true" />
        @carluve
      </a>
    </div>
  </HeroText>

  <Content
    image={{ src: portrait, alt: 'Portrait of Carlos Luengo Vera', aspect: '1/1' }}
    items={[
      {
        title: 'Industry',
        description:
          'Sr. Enterprise Account Executive at Cloudflare, responsible for digital natives, startups and ISVs.',
      },
      {
        title: 'Research',
        description:
          'PhD candidate in Artificial Intelligence and Management at Universidad de Alcalá. The thesis addresses the economic and organisational impact of language models.',
      },
      {
        title: 'Teaching',
        description:
          'Teaches on postgraduate and executive education programmes covering AI, cloud and digital transformation.',
      },
    ]}
  >
    <Fragment slot="content">
      <h2 class="mb-3 font-heading text-3xl font-medium tracking-tight text-heading">Introduction</h2>
      <p>
        His professional career has been built in account management and the technology ecosystem. In order, from the
        start to the present day: Microsoft, Insight, Telefónica, Lenovo, Amazon Web Services and Cloudflare.
      </p>
      <br />
      <p>
        That experience with customers adopting AI and cloud is the raw material for his doctoral research and his
        teaching: how organisations change when they bring in language models.
      </p>
    </Fragment>
  </Content>

  <CareerTimeline />

  <Features
    id="academia-path"
    tagline="University"
    title="Academic path"
    subtitle="PhD, publications and university teaching."
    columns={2}
    items={[
      {
        title: 'PhD',
        description:
          'Artificial Intelligence and Management at Universidad de Alcalá. Available publications are listed in Academia and on Google Scholar.',
        icon: 'tabler:book-2',
      },
      {
        title: 'Accreditation',
        description: 'Working towards teaching and research accreditation in the Spanish university system.',
        icon: 'tabler:school',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Academia',
        href: getPermalink('/en/academia'),
      },
      {
        text: 'Contact',
        href: getPermalink('/en/contact'),
      },
    ]}
  >
    <Fragment slot="title">Research and teaching</Fragment>
    <Fragment slot="subtitle">Publications, talks and classes, gathered in Academia.</Fragment>
  </CallToAction>
</Layout>
