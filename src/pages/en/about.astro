---
import StructuredData from '~/components/common/StructuredData.astro';
import { PERSON_ID, SITE_URL } from '~/data/identity';
import CareerTimeline from '~/components/widgets/CareerTimeline.astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import OrcidBadge from '~/components/common/OrcidBadge.astro';
import { xUrl } from '~/navigation';
import { getPermalink } from '~/utils/permalinks';
import portrait from '~/assets/images/carlos-luengo.jpg';

const metadata = {
  title: 'About',
  description:
    'Professional and academic background of Carlos Luengo Vera: enterprise account leadership at Cloudflare, a PhD in Artificial Intelligence and Management at Universidad de Alcalá, and postgraduate teaching.',
};
---

<Layout metadata={metadata}>
  <StructuredData
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: `${SITE_URL}/en/about`,
      inLanguage: 'en',
      mainEntity: { '@id': PERSON_ID },
    }}
  />
  <HeroText
    tagline="About"
    title="Professional and academic background"
    subtitle="I work in the technology industry and, alongside it, do research and teach at university."
  >
    <div slot="content" class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <OrcidBadge />
      <a
        class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-3 py-2 text-sm font-medium text-heading transition duration-150 ease-in-out hover:border-primary/40 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        href={xUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="tabler:brand-x" class="h-5 w-5 shrink-0" aria-hidden="true" />
        @carluve
      </a>
    </div>
  </HeroText>

  <Content
    image={{ src: portrait, alt: 'Portrait of Carlos Luengo Vera', aspect: '1/1' }}
    items={[
      {
        title: 'Industry',
        description:
          'I am a Sr. Enterprise Account Executive at Cloudflare, working with digital natives, startups and ISVs.',
      },
      {
        title: 'Research',
        description:
          'I am a PhD candidate in Artificial Intelligence and Management at Universidad de Alcalá. My thesis looks at the economic and organisational impact of language models.',
      },
      {
        title: 'Teaching',
        description:
          'I teach on postgraduate and executive education programmes covering AI, cloud and digital transformation.',
      },
    ]}
  >
    <Fragment slot="content">
      <h2 class="mb-3 font-heading text-3xl font-medium tracking-tight text-heading">Introduction</h2>
      <p>
        I have spent my whole career in account management in the technology sector. I started at Microsoft, then worked
        at Insight, Telefónica, Lenovo and Amazon Web Services before joining Cloudflare.
      </p>
      <br />
      <p>
        Working every day with customers who are adopting AI and cloud feeds directly into my doctoral research and my
        teaching. The question I care about is how organisations change when they bring in language models.
      </p>
    </Fragment>
  </Content>

  <CareerTimeline />

  <Features
    id="academia-path"
    tagline="University"
    title="Academic path"
    subtitle="My PhD, my publications and my university teaching."
    columns={2}
    items={[
      {
        title: 'PhD',
        description:
          'I am doing my PhD in Artificial Intelligence and Management at Universidad de Alcalá. You can find my publications on the Research page and on Google Scholar.',
        icon: 'tabler:book-2',
      },
      {
        title: 'Accreditation',
        description: 'I am working towards teaching and research accreditation in the Spanish university system.',
        icon: 'tabler:school',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Research',
        href: getPermalink('/en/academia'),
      },
      {
        text: 'Contact',
        href: getPermalink('/en/contact'),
      },
    ]}
  >
    <Fragment slot="title">Research and teaching</Fragment>
    <Fragment slot="subtitle">My publications, talks and classes, all on the Research page.</Fragment>
  </CallToAction>
</Layout>
