---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import BlogOverview from '~/components/blog/BlogOverview.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink as basePermalink, getBlogPermalink as baseBlogPermalink } from '~/utils/permalinks';
import { getLang, localizePath, useTranslations } from '~/i18n/utils';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

const lang = getLang(Astro);
const t = useTranslations(lang);
const getPermalink = (slug: string, type?: string) =>
  localizePath(basePermalink(slug, type as Parameters<typeof basePermalink>[1]), lang);
const getBlogPermalink = () => localizePath(baseBlogPermalink(), lang);

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const breadcrumbs = [
  { text: t('nav.home'), href: getPermalink('/') },
  ...(currentPage > 1
    ? [{ text: 'Blog', href: getBlogPermalink() }, { text: `${t('blog.page')} ${currentPage}` }]
    : [{ text: 'Blog' }]),
];

const metadata = {
  title: `Blog${currentPage > 1 ? ` — ${t('blog.page')} ${currentPage}` : ''}`,
  description:
    lang === 'en'
      ? 'Posts on cloud infrastructure, applied artificial intelligence and the link between industry and academia.'
      : 'Notas sobre infraestructura cloud, inteligencia artificial aplicada y la relación entre industria y universidad.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:py-20">
    <Headline subtitle={t('blog.subtitle')}> Blog </Headline>
    <BlogOverview />
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
