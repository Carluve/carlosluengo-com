---
import StructuredData from '~/components/common/StructuredData.astro';
import { PERSON_ID, SITE_URL } from '~/data/identity';
import CareerTimeline from '~/components/widgets/CareerTimeline.astro';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import OrcidBadge from '~/components/common/OrcidBadge.astro';
import { xUrl } from '~/navigation';
import { getPermalink } from '~/utils/permalinks';
import portrait from '~/assets/images/carlos-luengo.jpg';

const metadata = {
  title: 'Sobre mí',
  description:
    'Trayectoria profesional y académica de Carlos Luengo Vera: dirección de cuentas enterprise en Cloudflare, doctorado en Inteligencia Artificial y Management en la Universidad de Alcalá y docencia de posgrado.',
};
---

<Layout metadata={metadata}>
  <StructuredData
    slot="head"
    schema={{
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      url: `${SITE_URL}/about`,
      inLanguage: 'es',
      mainEntity: { '@id': PERSON_ID },
    }}
  />
  <HeroText
    tagline="Sobre mí"
    title="Trayectoria profesional y académica"
    subtitle="Carlos Luengo Vera trabaja en la industria tecnológica y, en paralelo, en la investigación y la docencia universitarias."
  >
    <div slot="content" class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <OrcidBadge />
      <a
        class="inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-3 py-2 text-sm font-medium text-heading transition duration-150 ease-in-out hover:border-primary/40 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        href={xUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="tabler:brand-x" class="h-5 w-5 shrink-0" aria-hidden="true" />
        @carluve
      </a>
    </div>
  </HeroText>

  <Content
    image={{ src: portrait, alt: 'Retrato de Carlos Luengo Vera', aspect: '1/1' }}
    items={[
      {
        title: 'Industria',
        description:
          'Sr. Enterprise Account Executive en Cloudflare, con responsabilidad sobre empresas digitales nativas, startups e ISVs.',
      },
      {
        title: 'Investigación',
        description:
          'Doctorando en Inteligencia Artificial y Management en la Universidad de Alcalá. La tesis aborda el impacto económico y organizativo de los modelos de lenguaje.',
      },
      {
        title: 'Docencia',
        description:
          'Imparte clase en programas de posgrado y de formación ejecutiva sobre IA, cloud y transformación digital.',
      },
    ]}
  >
    <Fragment slot="content">
      <h2 class="mb-3 font-heading text-3xl font-medium tracking-tight text-heading">Presentación</h2>
      <p>
        La actividad profesional se ha desarrollado en la dirección de cuentas y en el ecosistema tecnológico. La
        secuencia, de los inicios a la etapa actual, es Microsoft, Insight, Telefónica, Lenovo, Amazon Web Services y
        Cloudflare.
      </p>
      <br />
      <p>
        Esa experiencia con clientes que adoptan IA y cloud es la materia prima de su investigación doctoral y de sus
        clases: cómo cambian las organizaciones cuando incorporan modelos de lenguaje.
      </p>
    </Fragment>
  </Content>

  <CareerTimeline />

  <Features
    id="academia-path"
    tagline="Universidad"
    title="Proyección académica"
    subtitle="Doctorado, publicaciones y docencia universitaria."
    columns={2}
    items={[
      {
        title: 'Doctorado',
        description:
          'Inteligencia Artificial y Management en la Universidad de Alcalá. Las publicaciones disponibles se recogen en Academia y en Google Scholar.',
        icon: 'tabler:book-2',
      },
      {
        title: 'Acreditación',
        description: 'Camino hacia la acreditación docente e investigadora en la universidad española.',
        icon: 'tabler:school',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Academia',
        href: getPermalink('/academia'),
      },
      {
        text: 'Contacto',
        href: getPermalink('/contact'),
      },
    ]}
  >
    <Fragment slot="title">Investigación y docencia</Fragment>
    <Fragment slot="subtitle">Publicaciones, charlas y clases, reunidas en Academia.</Fragment>
  </CallToAction>
</Layout>
