---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Sobre mí',
  description:
    'Trayectoria profesional y académica de Carlos Luengo Vera: dirección de cuentas enterprise en Cloudflare, doctorado en Inteligencia Artificial y Management en la Universidad de Alcalá y docencia de posgrado.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Sobre mí"
    title="Trayectoria profesional y académica"
    subtitle="Carlos Luengo Vera trabaja en la industria tecnológica y, en paralelo, en la investigación y la docencia universitarias."
  />

  <Content
    isReversed
    items={[
      {
        title: 'Industria',
        description:
          'Sr. Enterprise Account Executive en Cloudflare, con responsabilidad sobre empresas digitales nativas, startups e ISVs.',
      },
      {
        title: 'Investigación',
        description:
          'Doctorando en Inteligencia Artificial y Management en la Universidad de Alcalá. La tesis aborda el impacto económico y organizativo de los modelos de lenguaje.',
      },
      {
        title: 'Docencia',
        description:
          'Imparte clase en programas de posgrado y de formación ejecutiva, con la intención de consolidar una carrera académica en España.',
      },
    ]}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Presentación</h2>
      <p>
        La actividad profesional se ha desarrollado en la dirección de cuentas y en el ecosistema tecnológico. La
        responsabilidad actual está en Cloudflare. Con anterioridad ha trabajado en Amazon Web Services, Lenovo,
        Telefónica, Insight y Microsoft.
      </p>
      <br />
      <p>
        Esa práctica informa la investigación doctoral y la docencia, sin sustituirlas. El objetivo académico es la
        acreditación en el sistema universitario español y, a más largo plazo, una cátedra.
      </p>
    </Fragment>
  </Content>

  <Features
    id="carrera"
    tagline="Industria"
    title="Experiencia profesional"
    subtitle="Organizaciones en las que ha desempeñado funciones comerciales, de ecosistema o de dirección de cuentas, de la etapa actual a los inicios."
    columns={3}
    items={[
      {
        title: 'Cloudflare',
        description:
          'Sr. Enterprise Account Executive. Cuentas de empresas digitales nativas, startups e ISVs. Etapa actual.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Amazon Web Services',
        description: 'Dirección de cuentas y soluciones cloud para clientes de empresa y del canal de partners.',
        icon: 'tabler:brand-aws',
      },
      {
        title: 'Lenovo',
        description: 'Funciones comerciales y de ecosistema en infraestructura y dispositivos.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Telefónica',
        description: 'Relación con clientes en telecomunicaciones y servicios cloud.',
        icon: 'tabler:antenna',
      },
      {
        title: 'Insight',
        description: 'Soluciones tecnológicas para empresas.',
        icon: 'tabler:building',
      },
      {
        title: 'Microsoft',
        description: 'Inicios de la carrera, en evangelismo técnico del ecosistema Microsoft.',
        icon: 'tabler:brand-windows',
      },
    ]}
  />

  <Features
    id="academia-path"
    tagline="Universidad"
    title="Proyección académica"
    subtitle="Investigación y docencia orientadas a una carrera estable en la universidad española."
    columns={2}
    items={[
      {
        title: 'Doctorado',
        description:
          'Inteligencia Artificial y Management en la Universidad de Alcalá. Las publicaciones disponibles se recogen en Academia y en Google Scholar.',
        icon: 'tabler:book-2',
      },
      {
        title: 'Acreditación',
        description:
          'La trayectoria se orienta a la acreditación docente e investigadora y, en su momento, a una cátedra en España.',
        icon: 'tabler:school',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Academia',
        href: getPermalink('/academia'),
      },
      {
        text: 'Contacto',
        href: getPermalink('/contact'),
      },
    ]}
  >
    <Fragment slot="title">Publicaciones y correspondencia</Fragment>
    <Fragment slot="subtitle">
      La actividad investigadora y docente se detalla en Academia. Las consultas pueden dirigirse desde Contacto.
    </Fragment>
  </CallToAction>
</Layout>
