---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import OrcidBadge from '~/components/common/OrcidBadge.astro';
import { xUrl } from '~/navigation';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Sobre mí',
  description:
    'Trayectoria profesional y académica de Carlos Luengo Vera: dirección de cuentas enterprise en Cloudflare, doctorado en Inteligencia Artificial y Management en la Universidad de Alcalá y docencia de posgrado.',
};

const career = [
  {
    title: 'Cloudflare',
    description:
      'Sr. Enterprise Account Executive. Cuentas de empresas digitales nativas, startups e ISVs. Etapa actual.',
  },
  {
    title: 'Amazon Web Services',
    description: 'Dirección de cuentas y soluciones cloud para clientes de empresa y del canal de partners.',
  },
  {
    title: 'Lenovo',
    description: 'Funciones comerciales y de ecosistema en infraestructura y dispositivos.',
  },
  {
    title: 'Telefónica',
    description: 'Relación con clientes en telecomunicaciones y servicios cloud.',
  },
  {
    title: 'Insight',
    description: 'Soluciones tecnológicas para empresas.',
  },
  {
    title: 'Microsoft',
    description: 'Inicios de la carrera, en evangelismo técnico del ecosistema Microsoft.',
  },
];
---

<Layout metadata={metadata} shellTitle="Sobre mí">
  <section class="panel">
    <p class="max-w-3xl leading-relaxed text-muted">
      Carlos Luengo Vera trabaja en la industria tecnológica y, en paralelo, en la investigación y la docencia
      universitarias. La actividad profesional se ha desarrollado en la dirección de cuentas y en el ecosistema
      tecnológico. La secuencia, de los inicios a la etapa actual, es Microsoft, Insight, Telefónica, Lenovo, Amazon Web
      Services y Cloudflare.
    </p>
    <p class="mt-3 max-w-3xl leading-relaxed text-muted">
      Esa práctica informa la investigación doctoral y la docencia, sin sustituirlas. El objetivo académico es la
      acreditación en el sistema universitario español y, a más largo plazo, una cátedra.
    </p>
    <div class="mt-5 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center">
      <OrcidBadge />
      <a class="dash-btn" href={xUrl} target="_blank" rel="noopener noreferrer">
        <Icon name="tabler:brand-x" class="h-4 w-4" aria-hidden="true" />
        @carluve
      </a>
    </div>
  </section>

  <section class="panel mt-4">
    <h2>Experiencia profesional</h2>
    <p class="mb-2">
      Organizaciones en las que ha desempeñado funciones comerciales, de ecosistema o de dirección de cuentas, de la
      etapa actual a los inicios. No hay un año de comienzo publicado.
    </p>
    <table class="org-table">
      <caption class="sr-only">Organizaciones, de la etapa actual a los inicios</caption>
      <thead>
        <tr>
          <th scope="col">Organización</th>
          <th scope="col">Función documentada</th>
        </tr>
      </thead>
      <tbody>
        {
          career.map((item) => (
            <tr>
              <th scope="row">{item.title}</th>
              <td>{item.description}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <div class="stack-2 mt-4">
    <section class="panel">
      <h2>Investigación</h2>
      <p>
        Doctorando en Inteligencia Artificial y Management en la Universidad de Alcalá. La tesis aborda el impacto
        económico y organizativo de los modelos de lenguaje. Las publicaciones disponibles se recogen en Academia y en
        Google Scholar.
      </p>
      <p class="mt-3">
        <a class="font-semibold text-link hover:underline" href={getPermalink('/academia')}>Ver Academia</a>
      </p>
    </section>
    <section class="panel">
      <h2>Docencia</h2>
      <p>
        Imparte clase en programas de posgrado y de formación ejecutiva, con la intención de consolidar una carrera
        académica en España. La trayectoria se orienta a la acreditación docente e investigadora y, en su momento, a
        una cátedra.
      </p>
    </section>
  </div>
</Layout>
