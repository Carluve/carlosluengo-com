---
import Layout from '~/layouts/Layout.astro';
import AppShell from '~/components/shell/AppShell.astro';

import type { MetaData } from '~/types';

interface Segment {
  id: string;
  label: string;
}

export interface Props {
  metadata?: MetaData;
  shellTitle?: string;
  /** Set false when the page body already has its own h1. */
  shellHeading?: boolean;
  segments?: Segment[];
  filterLabel?: string;
  filterHref?: string;
}

const {
  metadata,
  shellTitle,
  shellHeading = true,
  segments = [],
  filterLabel,
  filterHref,
} = Astro.props;

const title = shellTitle || metadata?.title || 'Carlos Luengo';
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  {Astro.slots.has('announcement') && <slot name="announcement" />}
  <AppShell title={title} heading={shellHeading} segments={segments} filterLabel={filterLabel} filterHref={filterHref}>
    <slot />
  </AppShell>
</Layout>
