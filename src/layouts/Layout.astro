---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection}>
  <head>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-source-serif" preload />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://media.carlosluengo.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="aw-canvas antialiased text-default bg-page min-h-screen flex flex-col">
    <slot />

    <Intersect />

    <script>
      // Feed the pointer position to `.aw-spotlight` cards (see tailwind.css).
      // One delegated listener survives client-side navigations.
      if (matchMedia('(hover: hover)').matches) {
        document.addEventListener(
          'pointermove',
          (event) => {
            const card = (event.target as Element | null)?.closest?.<HTMLElement>('.aw-spotlight');
            if (!card) return;
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--aw-mx', `${event.clientX - rect.left}px`);
            card.style.setProperty('--aw-my', `${event.clientY - rect.top}px`);
          },
          { passive: true }
        );

        // Frosted tooltip for chart marks with `data-tip` (EvilCharts, MIT).
        let tip: HTMLDivElement | undefined;
        document.addEventListener(
          'pointerover',
          (event) => {
            const mark = (event.target as Element | null)?.closest?.<HTMLElement | SVGElement>('[data-tip]');
            if (!mark) {
              tip?.removeAttribute('data-show');
              return;
            }
            if (!tip || !tip.isConnected) {
              tip = document.createElement('div');
              tip.className = 'aw-tip';
              tip.setAttribute('role', 'tooltip');
              document.body.append(tip);
            }
            const rect = mark.getBoundingClientRect();
            tip.textContent = mark.dataset.tip ?? '';
            tip.style.left = `${rect.left + rect.width / 2}px`;
            tip.style.top = `${rect.top}px`;
            tip.setAttribute('data-show', '');
          },
          { passive: true }
        );
        document.addEventListener('scroll', () => tip?.removeAttribute('data-show'), { passive: true });
      }
    </script>
  </body>
</html>
