// Cloudflare Pages / Workers static assets. Build with `npm run build`; serve `dist/`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carlosluengo-com",
  // carluve @enterprise, which also holds the zone and the R2 bucket. Pinned so
  // wrangler never prompts between the two accounts on this login.
  "account_id": "39f8ea10b94ad38470fc3c20c260efdc",
  "compatibility_date": "2026-09-01",
  // Post media is not deployed with the site: it lives in the R2 bucket
  // `carlosluengo-media`, served at https://media.carlosluengo.com
  // (see scripts/media.mjs and src/utils/media.ts).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Astro builds with trailingSlash 'never' (src/config.yaml): pages and
    // canonical tags are /blog/post. Serve them there and redirect /blog/post/
    // to it, instead of the default 307 from /blog/post to /blog/post/.
    "html_handling": "drop-trailing-slash",
  },
}
